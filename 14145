namespace KRPCarKeys
{
    public class Main : RocketPlugin<Configuration>
    {
        public static Main Instance;
        public static VehicleDatabase Database;

        private Harmony _harmony;

        public static readonly ushort[] KeyIds = { 58124, 58125, 58126, 58127, 58128, 58129, 58130, 58131 };

        protected override void Load()
        {
            Instance = this;
            Database = new VehicleDatabase(Directory);

            _harmony = new Harmony("com.krp.carkeys");
            _harmony.PatchAll();

            Provider.onServerDisconnected += OnServerDisconnected;

            Rocket.Core.Logging.Logger.Log("[KRPCarKeys] Загружен! База данных инициализирована.");
        }

        // ==========================================
        // Закрытие всех открытых машин
        // ==========================================
        private void CloseAllOpenVehicles()
        {
            int closedCount = 0;

            foreach (var vehicle in VehicleManager.vehicles)
            {
                ulong guid = 0;
                if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
                {
                    guid = vehicle.lockedOwner.m_SteamID;
                }
                else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
                {
                    guid = vehicle.lockedGroup.m_SteamID;
                }

                if (guid != 0) continue;

                var allData = Main.Database.GetAll();
                foreach (var kvp in allData)
                {
                    if (kvp.Value.instanceID == (int)vehicle.instanceID)
                    {
                        guid = kvp.Key;
                        break;
                    }
                }

                if (guid == 0) continue;

                VehicleManager.ServerSetVehicleLock(vehicle, new CSteamID(guid), new CSteamID(guid), true);
                closedCount++;
            }

            if (closedCount > 0)
            {
                Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Закрыто {closedCount} открытых машин");
            }
        }

        private void OnServerDisconnected(CSteamID steamID)
        {
            if (steamID == CSteamID.Nil) return;

            List<ulong> guids = FindAllKeyGuidsInInventory(steamID);
            if (guids.Count == 0) return;

            foreach (ulong guid in guids)
            {
                InteractableVehicle targetVehicle = null;
                foreach (var vehicle in VehicleManager.vehicles)
                {
                    ulong vehicleGuid = 0;
                    if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
                    {
                        vehicleGuid = vehicle.lockedOwner.m_SteamID;
                    }
                    else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
                    {
                        vehicleGuid = vehicle.lockedGroup.m_SteamID;
                    }

                    if (vehicleGuid == guid)
                    {
                        targetVehicle = vehicle;
                        break;
                    }
                }

                if (targetVehicle == null) continue;

                VehicleData data = Main.Database.LoadVehicle(guid);
                if (data == null)
                {
                    data = new VehicleData
                    {
                        GUID = guid,
                        vehicleID = targetVehicle.asset?.id ?? 0,
                        vehicleName = targetVehicle.asset?.FriendlyName ?? "Unknown"
                    };
                }

                data.health = targetVehicle.health;
                data.fuel = targetVehicle.fuel;
                data.battery = targetVehicle.batteryCharge;

                data.lastPosition = new Vector3Data
                {
                    x = targetVehicle.transform.position.x,
                    y = targetVehicle.transform.position.y,
                    z = targetVehicle.transform.position.z
                };

                if (targetVehicle.tires != null)
                {
                    data.wheels = new byte[targetVehicle.tires.Length];
                    for (int i = 0; i < targetVehicle.tires.Length && i < 4; i++)
                    {
                        data.wheels[i] = (byte)(targetVehicle.tires[i].isAlive ? 1 : 0);
                    }
                }

                // instanceID не обновляем — он постоянный
                Main.Database.SaveVehicle(data);
                System.Threading.Thread.Sleep(50);
            }

            CloseAllOpenVehicles();
        }

        // ==========================================
        // Сохранение ВСЕХ машин при перезапуске
        // ==========================================
        private void SaveAllVehicles()
        {
            int savedCount = 0;

            foreach (var vehicle in VehicleManager.vehicles)
            {
                ulong guid = 0;
                if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
                {
                    guid = vehicle.lockedOwner.m_SteamID;
                }
                else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
                {
                    guid = vehicle.lockedGroup.m_SteamID;
                }

                if (guid == 0) continue;

                VehicleData data = Main.Database.LoadVehicle(guid);
                if (data == null)
                {
                    data = new VehicleData
                    {
                        GUID = guid,
                        vehicleID = vehicle.asset?.id ?? 0,
                        vehicleName = vehicle.asset?.FriendlyName ?? "Unknown"
                    };
                }

                data.health = vehicle.health;
                data.fuel = vehicle.fuel;
                data.battery = vehicle.batteryCharge;

                data.lastPosition = new Vector3Data
                {
                    x = vehicle.transform.position.x,
                    y = vehicle.transform.position.y,
                    z = vehicle.transform.position.z
                };

                if (vehicle.tires != null)
                {
                    data.wheels = new byte[vehicle.tires.Length];
                    for (int i = 0; i < vehicle.tires.Length && i < 4; i++)
                    {
                        data.wheels[i] = (byte)(vehicle.tires[i].isAlive ? 1 : 0);
                    }
                }

                // instanceID не обновляем — он постоянный
                Main.Database.SaveVehicle(data);
                savedCount++;
            }

            Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Сохранено {savedCount} машин при выгрузке плагина");
        }

        // ==========================================
        // Методы для поиска ключей в инвентаре
        // ==========================================
        private List<ulong> FindAllKeyGuidsInInventory(CSteamID steamID)
        {
            List<ulong> guids = new List<ulong>();
            string basePath = $"{ReadWrite.PATH}/Servers/Default/Players/{steamID}_";

            for (int character = 0; character <= 4; character++)
            {
                string playerFolder = $"{basePath}{character}";
                if (!System.IO.Directory.Exists(playerFolder)) continue;

                string[] mapFolders = System.IO.Directory.GetDirectories(playerFolder);
                foreach (string mapFolder in mapFolders)
                {
                    string inventoryPath = System.IO.Path.Combine(mapFolder, "Player", "Inventory.dat");
                    if (System.IO.File.Exists(inventoryPath))
                    {
                        List<ulong> foundGuids = FindAllKeyGuidsInInventoryFile(inventoryPath);
                        foreach (ulong guid in foundGuids)
                        {
                            if (!guids.Contains(guid))
                            {
                                guids.Add(guid);
                            }
                        }
                    }
                }
            }

            return guids;
        }

        private List<ulong> FindAllKeyGuidsInInventoryFile(string filePath)
        {
            List<ulong> guids = new List<ulong>();

            try
            {
                byte[] inventoryData = System.IO.File.ReadAllBytes(filePath);
                int offset = 1;

                for (byte page = 0; page < 9; page++)
                {
                    if (offset + 2 >= inventoryData.Length) break;

                    byte count = inventoryData[offset + 2];
                    offset += 3;

                    for (byte i = 0; i < count; i++)
                    {
                        if (offset + 8 >= inventoryData.Length) break;

                        ushort itemId = BitConverter.ToUInt16(inventoryData, offset + 3);
                        byte stateLength = inventoryData[offset + 7];
                        offset += 8;

                        if (stateLength >= 8 && offset + stateLength <= inventoryData.Length)
                        {
                            byte[] state = new byte[stateLength];
                            Array.Copy(inventoryData, offset, state, 0, stateLength);
                            offset += stateLength;

                            if (Main.KeyIds.Contains(itemId))
                            {
                                ulong guid = BitConverter.ToUInt64(state, 0);
                                if (Main.IsOurGUID(guid) && !guids.Contains(guid))
                                {
                                    guids.Add(guid);
                                }
                            }
                        }
                    }
                }
            }
            catch
            {
                return guids;
            }

            return guids;
        }

        protected override void Unload()
        {
            Provider.onServerDisconnected -= OnServerDisconnected;

            CloseAllOpenVehicles();
            SaveAllVehicles();

            _harmony?.UnpatchAll("com.krp.carkeys");

            Database?.ForceSaveAll();

            Rocket.Core.Logging.Logger.Log("[KRPCarKeys] Выгружен");
        }

        public static ulong GenerateGUID()
        {
            System.Random random = new System.Random();
            return (ulong)random.Next(1000000, 999999999);
        }

        public static bool IsOurGUID(ulong id)
        {
            return id >= 1000000 && id <= 999999999;
        }
    }
}

