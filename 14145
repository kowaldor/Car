namespace KRPCarKeys.Patches
{
    [HarmonyPatch(typeof(InteractableVehicle))]
    [HarmonyPatch("tellLocked")]
    internal class Patch_TellLocked
    {
        private static bool Prefix(InteractableVehicle __instance, ref CSteamID owner, ref CSteamID group, ref bool locked)
        {
            // 1. Ищем GUID в полях машины
            ulong currentGuid = 0;
            if (Main.IsOurGUID(__instance.lockedOwner.m_SteamID))
            {
                currentGuid = __instance.lockedOwner.m_SteamID;
            }
            else if (Main.IsOurGUID(__instance.lockedGroup.m_SteamID))
            {
                currentGuid = __instance.lockedGroup.m_SteamID;
            }

            // 2. Если GUID нет — ищем в БД по instanceID
            if (currentGuid == 0)
            {
                var allData = Main.Database.GetAll();
                foreach (var kvp in allData)
                {
                    if (kvp.Value.instanceID == (int)__instance.instanceID)
                    {
                        currentGuid = kvp.Key;
                        break;
                    }
                }
            }

            // 3. Если GUID нет — выходим (машина без ключа)
            if (currentGuid == 0)
            {
                return true;
            }

            // 4. ОТКРЫТИЕ МАШИНЫ
            if (!locked)
            {
                owner = CSteamID.Nil;
                group = CSteamID.Nil;
                locked = false;
                return true;
            }

            // 5. ЗАКРЫТИЕ МАШИНЫ — ВСЕГДА используем GUID
            if (locked)
            {
                owner = new CSteamID(currentGuid);
                group = new CSteamID(currentGuid);
                locked = true;
                return true;
            }

            return true;
        }
    }
}

using HarmonyLib;
using KRPCarKeys.Database;
using Rocket.Unturned.Player;
using SDG.Unturned;
using Steamworks;
using System;
using System.Linq;
using UnityEngine;

namespace KRPCarKeys.Patches
{
    [HarmonyPatch(typeof(PlayerLife))]
    [HarmonyPatch("askEat")]
    internal class Patch_UseKey
    {
        private static void Prefix(PlayerLife __instance, byte amount)
        {
            if (__instance == null || __instance.player == null) return;

            Player player = __instance.player;
            if (player == null) return;

            PlayerEquipment equipment = player.equipment;
            if (equipment == null) return;

            ushort itemId = equipment.itemID;
            if (!Main.KeyIds.Contains(itemId))
            {
                return;
            }

            CSteamID steamID = player.channel.owner.playerID.steamID;
            UnturnedPlayer unturnedPlayer = UnturnedPlayer.FromCSteamID(steamID);
            if (unturnedPlayer == null) return;

            byte[] state = equipment.state;
            if (state == null || state.Length < 8)
            {
                return;
            }

            ulong keyGuid = BitConverter.ToUInt64(state, 0);
            if (!Main.IsOurGUID(keyGuid))
            {
                return;
            }

            Vector3 origin = player.look.aim.position - player.look.aim.forward * 0.5f;
            Vector3 direction = player.look.aim.forward;
            float distance = 4f;
            int layerMask = RayMasks.VEHICLE;

            RaycastHit hit;
            if (!Physics.Raycast(origin, direction, out hit, distance, layerMask))
            {
                return;
            }

            InteractableVehicle vehicle = hit.transform.GetComponent<InteractableVehicle>();
            if (vehicle == null)
            {
                return;
            }

            // Проверка: есть ли свободные места?
            bool hasFreeSeat = false;
            if (vehicle.passengers != null)
            {
                for (byte i = 0; i < vehicle.passengers.Length; i++)
                {
                    if (vehicle.passengers[i].player == null)
                    {
                        hasFreeSeat = true;
                        break;
                    }
                }
            }

            if (!hasFreeSeat)
            {
                return;
            }

            // ==========================================
            // 1. Ищем GUID в полях машины
            // ==========================================
            ulong vehicleGuid = 0;
            if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
            {
                vehicleGuid = vehicle.lockedOwner.m_SteamID;
            }
            else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
            {
                vehicleGuid = vehicle.lockedGroup.m_SteamID;
            }

            // ==========================================
            // 2. Если не нашли — ищем в БД по instanceID
            // ==========================================
            if (vehicleGuid == 0)
            {
                var allData = Main.Database.GetAll();
                foreach (var kvp in allData)
                {
                    if (kvp.Value.instanceID == (int)vehicle.instanceID)
                    {
                        vehicleGuid = kvp.Key;
                        break;
                    }
                }
            }

            // ==========================================
            // 3. Если GUID найден — проверяем совпадение с ключом
            // ==========================================
            if (vehicleGuid != 0)
            {
                // Восстанавливаем GUID в полях машины (если машина открыта)
                if (vehicle.lockedOwner.m_SteamID == 0 && vehicle.lockedGroup.m_SteamID == 0)
                {
                    VehicleManager.ServerSetVehicleLock(vehicle, new CSteamID(vehicleGuid), new CSteamID(vehicleGuid), true);
                }

                if (vehicleGuid == keyGuid)
                {
                    TryEnterVehicle(vehicle, unturnedPlayer);
                }
                else
                {
                    Rocket.Unturned.Chat.UnturnedChat.Say(unturnedPlayer, "Этот ключ не подходит к этому транспорту!");
                }
                return;
            }

            // ==========================================
            // 4. Если GUID не найден — машина не создана через /v
            // ==========================================
            if (vehicleGuid == 0)
            {
                Rocket.Unturned.Chat.UnturnedChat.Say(unturnedPlayer, "Этот транспорт не имеет ключа!");
            }
        }

        private static void TryEnterVehicle(InteractableVehicle vehicle, UnturnedPlayer player)
        {
            if (vehicle == null || player == null) return;

            if (vehicle.passengers == null || vehicle.passengers.Length == 0)
            {
                return;
            }

            VehicleManager.ServerForcePassengerIntoVehicle(player.Player, vehicle);
        }
    }
}

using System.Collections.Generic;
using Newtonsoft.Json;

namespace KRPCarKeys.Database
{
    public class VehicleData
    {
        [JsonProperty("GUID")]
        public ulong GUID { get; set; }

        [JsonProperty("vehicleID")]
        public ushort vehicleID { get; set; }

        [JsonProperty("vehicleName")]
        public string vehicleName { get; set; }

        [JsonProperty("keyIDs")]
        public List<ushort> keyIDs { get; set; }

        // === Временный ID для связи с игрой ===
        [JsonProperty("instanceID")]
        public int instanceID { get; set; }

        // === Владелец (для будущего) ===
        [JsonProperty("steamID")]
        public string steamID { get; set; }

        [JsonProperty("licensePlate")]
        public string licensePlate { get; set; }

        // === Состояние машины ===
        [JsonProperty("health")]
        public ushort health { get; set; }

        [JsonProperty("battery")]
        public ushort battery { get; set; }

        [JsonProperty("fuel")]
        public ushort fuel { get; set; }

        [JsonProperty("wheels")]
        public byte[] wheels { get; set; }

        [JsonProperty("lastPosition")]
        public Vector3Data lastPosition { get; set; }

        [JsonProperty("baggage")]
        public List<ItemData> baggage { get; set; }

        // === Ключи (отдельная таблица) ===
        [JsonProperty("keys")]
        public List<KeyData> keys { get; set; }

        public VehicleData()
        {
            keyIDs = new List<ushort>();
            baggage = new List<ItemData>();
            wheels = new byte[4];
            keys = new List<KeyData>();
            steamID = "";
            licensePlate = "";
            instanceID = 0;
        }
    }

    public class Vector3Data
    {
        public float x { get; set; }
        public float y { get; set; }
        public float z { get; set; }
    }

    public class ItemData
    {
        public ushort itemID { get; set; }
        public byte amount { get; set; }
        public byte quality { get; set; }
        public byte[] state { get; set; }
    }

    // === Отдельный класс для ключей ===
    public class KeyData
    {
        [JsonProperty("keyID")]
        public ushort KeyID { get; set; }

        [JsonProperty("vehicleGUID")]
        public ulong VehicleGUID { get; set; }

        [JsonProperty("state")]
        public byte[] State { get; set; }

        public KeyData()
        {
            State = new byte[0];
        }
    }
}

using System;
using System.Collections.Generic;
using System.IO;
using Newtonsoft.Json;

namespace KRPCarKeys.Database
{
    public class VehicleDatabase
    {
        private readonly string filePath;
        private Dictionary<ulong, VehicleData> _cache;
        private readonly object _lock = new object();

        public VehicleDatabase(string pluginDirectory)
        {
            filePath = Path.Combine(pluginDirectory, "vehicles.json");
            _cache = new Dictionary<ulong, VehicleData>();
            LoadAll();
        }

        public void LoadAll()
        {
            lock (_lock)
            {
                if (!File.Exists(filePath))
                {
                    _cache = new Dictionary<ulong, VehicleData>();
                    return;
                }

                try
                {
                    string json = File.ReadAllText(filePath);
                    _cache = JsonConvert.DeserializeObject<Dictionary<ulong, VehicleData>>(json)
                           ?? new Dictionary<ulong, VehicleData>();
                }
                catch (Exception ex)
                {
                    Rocket.Core.Logging.Logger.Log($"[ERROR] LoadAll: {ex.Message}");
                    _cache = new Dictionary<ulong, VehicleData>();
                }
            }
        }

        public VehicleData LoadVehicle(ulong guid)
        {
            lock (_lock)
            {
                return _cache.TryGetValue(guid, out VehicleData data) ? data : null;
            }
        }

        public void SaveVehicle(VehicleData data)
        {
            if (data == null) return;

            lock (_lock)
            {
                _cache[data.GUID] = data;
                SaveAll();
            }
        }

        public void DeleteVehicle(ulong guid)
        {
            lock (_lock)
            {
                if (_cache.Remove(guid))
                {
                    SaveAll();
                }
            }
        }

        private void SaveAll()
        {
            try
            {
                string json = JsonConvert.SerializeObject(_cache, Formatting.Indented);
                File.WriteAllText(filePath, json);
            }
            catch (Exception ex)
            {
                Rocket.Core.Logging.Logger.Log($"[ERROR] SaveAll: {ex.Message}");
            }
        }

        public void ForceSaveAll()
        {
            lock (_lock)
            {
                SaveAll();
            }
        }

        public Dictionary<ulong, VehicleData> GetAll()
        {
            lock (_lock)
            {
                return new Dictionary<ulong, VehicleData>(_cache);
            }
        }
    }
}

using System.Collections.Generic;
using Rocket.API;
using Rocket.Unturned.Chat;
using Rocket.Unturned.Player;
using SDG.Unturned;
using UnityEngine;
using KRPCarKeys.Database;

namespace KRPCarKeys.Commands
{
    public class CommandVD : IRocketCommand
    {
        public AllowedCaller AllowedCaller => AllowedCaller.Player;
        public string Name => "vehicledestroy";
        public string Help => "Удаляет транспорт, на который смотришь";
        public string Syntax => "";
        public List<string> Aliases => new List<string> { "vd" };
        public List<string> Permissions => new List<string> { "krpcarkeys.admin" };

        public void Execute(IRocketPlayer caller, string[] command)
        {
            UnturnedPlayer player = (UnturnedPlayer)caller;

            Vector3 origin = player.Player.look.aim.position - player.Player.look.aim.forward * 0.5f;
            Vector3 direction = player.Player.look.aim.forward;
            float distance = 4f;

            int layerMask = RayMasks.VEHICLE;

            RaycastHit hit;
            if (!Physics.Raycast(origin, direction, out hit, distance, layerMask))
            {
                UnturnedChat.Say(caller, "Смотрите на транспорт!");
                return;
            }

            InteractableVehicle vehicle = hit.transform.GetComponent<InteractableVehicle>();
            if (vehicle == null)
            {
                return;
            }

            // Проверка: есть ли кто-то в машине
            if (vehicle.passengers != null)
            {
                foreach (Passenger passenger in vehicle.passengers)
                {
                    if (passenger != null && passenger.player != null)
                    {
                        UnturnedChat.Say(caller, "Нельзя удалить транспорт с игроком внутри!");
                        return;
                    }
                }
            }

            // ==========================================
            // 1. Ищем GUID в полях машины
            // ==========================================
            ulong guid = 0;
            if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
            {
                guid = vehicle.lockedOwner.m_SteamID;
            }
            else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
            {
                guid = vehicle.lockedGroup.m_SteamID;
            }

            // ==========================================
            // 2. Если не нашли — ищем в БД по instanceID
            // ==========================================
            if (guid == 0)
            {
                var allData = Main.Database.GetAll();
                foreach (var kvp in allData)
                {
                    if (kvp.Value.instanceID == (int)vehicle.instanceID)
                    {
                        guid = kvp.Key;
                        break;
                    }
                }
            }

            // ==========================================
            // 3. Если GUID найден — удаляем из БД
            // ==========================================
            if (guid != 0)
            {
                Main.Database.DeleteVehicle(guid);
            }

            // Эффекты при удалении (ID 19, 69, 138)
            Vector3 position = vehicle.transform.position;

            EffectAsset effect19 = Assets.find(EAssetType.EFFECT, 19) as EffectAsset;
            EffectAsset effect69 = Assets.find(EAssetType.EFFECT, 69) as EffectAsset;
            EffectAsset effect138 = Assets.find(EAssetType.EFFECT, 138) as EffectAsset;

            if (effect19 != null)
            {
                TriggerEffectParameters parameters = new TriggerEffectParameters(effect19);
                parameters.position = position;
                parameters.relevantDistance = EffectManager.LARGE;
                parameters.reliable = true;
                EffectManager.triggerEffect(parameters);
            }

            if (effect69 != null)
            {
                TriggerEffectParameters parameters = new TriggerEffectParameters(effect69);
                parameters.position = position;
                parameters.relevantDistance = EffectManager.LARGE;
                parameters.reliable = true;
                EffectManager.triggerEffect(parameters);
            }

            if (effect138 != null)
            {
                TriggerEffectParameters parameters = new TriggerEffectParameters(effect138);
                parameters.position = position;
                parameters.relevantDistance = EffectManager.LARGE;
                parameters.reliable = true;
                EffectManager.triggerEffect(parameters);
            }

            VehicleManager.askVehicleDestroy(vehicle);
            UnturnedChat.Say(caller, $"Транспорт {vehicle.asset?.FriendlyName ?? "Unknown"} удален!");
        }
    }
}

