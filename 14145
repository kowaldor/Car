using Rocket.API;
using Rocket.Unturned.Chat;
using Rocket.Unturned.Player;
using SDG.Unturned;
using System.Collections.Generic;
using UnityEngine;

namespace KRPCarKeys.Commands
{
    public class CommandParkEnter : IRocketCommand
    {
        public AllowedCaller AllowedCaller => AllowedCaller.Player;
        public string Name => "parkenter";
        public string Help => "Вход в закрытый транспорт";
        public string Syntax => "";
        public List<string> Aliases => new List<string>();
        public List<string> Permissions => new List<string> { "krpcarkeys.parkenter" };

        public void Execute(IRocketPlayer caller, string[] command)
        {
            UnturnedPlayer player = (UnturnedPlayer)caller;

            // Рейкаст с коррекцией (луч позади игрока)
            Vector3 origin = player.Player.look.aim.position - player.Player.look.aim.forward * 0.5f;
            Vector3 direction = player.Player.look.aim.forward;
            float distance = 4f;

            // Используем маску только для машин (слой 13)
            int layerMask = RayMasks.VEHICLE; // 67108864

            RaycastHit hit;
            if (!Physics.Raycast(origin, direction, out hit, distance, layerMask))
            {
                UnturnedChat.Say(caller, "Смотрите на транспорт!");
                return;
            }

            InteractableVehicle vehicle = hit.transform.GetComponent<InteractableVehicle>();
            if (vehicle == null)
            {
                return;
            }

            // Проверяем, есть ли места в машине
            if (vehicle.passengers == null || vehicle.passengers.Length == 0)
            {
                UnturnedChat.Say(caller, "В этом транспорте нет мест!");
                return;
            }

            // Проверяем, занято ли водительское место
            if (vehicle.passengers[0].player != null)
            {
                if (vehicle.passengers[0].player.playerID.steamID == player.CSteamID)
                {
                    VehicleManager.forceRemovePlayer(vehicle, player.CSteamID);
                }
                else
                {
                    UnturnedChat.Say(caller, "Водительское место занято другим игроком!");
                    return;
                }
            }

            // Принудительная синхронизация перед посадкой
            VehicleManager.ServerSetVehicleLock(vehicle, vehicle.lockedOwner, vehicle.lockedGroup, false);
            VehicleManager.ServerSetVehicleLock(vehicle, vehicle.lockedOwner, vehicle.lockedGroup, true);

            // Сажаем игрока за руль
            VehicleManager.ServerForcePassengerIntoVehicle(player.Player, vehicle);

            UnturnedChat.Say(caller, "Вы сели в транспорт!");
        }
    }
}

using Rocket.API;
using Rocket.API.Extensions;
using Rocket.Unturned.Chat;
using Rocket.Unturned.Player;
using SDG.Unturned;
using Steamworks;
using System;
using System.Collections.Generic;
using UnityEngine;
using KRPCarKeys.Database;

namespace KRPCarKeys.Commands
{
    public class CommandV : IRocketCommand
    {
        public AllowedCaller AllowedCaller => AllowedCaller.Player;
        public string Name => "vehicle";
        public string Help => "Создаёт транспорт и ключ к нему!";
        public string Syntax => "<id или название>";
        public List<string> Aliases => new List<string> { "v" };
        public List<string> Permissions => new List<string> { "krpcarkeys.admin" };

        public void Execute(IRocketPlayer caller, string[] command)
        {
            UnturnedPlayer player = (UnturnedPlayer)caller;

            if (command.Length == 0)
            {
                UnturnedChat.Say(caller, "Использование: /v <id или название>");
                return;
            }

            ushort? vehicleId = null;
            string search = command[0];

            if (ushort.TryParse(search, out ushort id))
            {
                vehicleId = id;
            }
            else
            {
                List<VehicleAsset> assets = new List<VehicleAsset>();
                Assets.find(assets);

                foreach (VehicleAsset asset in assets)
                {
                    if (asset != null && asset.FriendlyName != null &&
                        asset.FriendlyName.ToLower().Contains(search.ToLower()))
                    {
                        vehicleId = asset.id;
                        break;
                    }
                }
            }

            if (!vehicleId.HasValue)
            {
                UnturnedChat.Say(caller, $"Транспорт '{search}' не найден!");
                return;
            }

            // Создаём машину
            VehicleTool.giveVehicle(player.Player, vehicleId.Value);

            // Находим машину
            InteractableVehicle vehicle = null;
            var vehicles = VehicleManager.vehicles;
            if (vehicles.Count > 0)
            {
                vehicle = vehicles[vehicles.Count - 1];
            }

            if (vehicle == null)
            {
                UnturnedChat.Say(caller, "Ошибка: Транспорт не найден!");
                return;
            }

            // Генерируем GUID
            ulong vehicleGuid = Main.GenerateGUID();

            // Блокируем машину
            VehicleManager.ServerSetVehicleLock(vehicle, new CSteamID(vehicleGuid), new CSteamID(vehicleGuid), true);

            // Создаём ключ
            ushort keyId = Main.KeyIds[new System.Random().Next(Main.KeyIds.Length)];
            byte[] keyData = BitConverter.GetBytes(vehicleGuid);
            Item keyItem = new Item(keyId, 1, 100, keyData);

            // Находим название машины
            List<VehicleAsset> allAssets = new List<VehicleAsset>();
            Assets.find(allAssets);
            string vehicleName = "Unknown";
            foreach (VehicleAsset asset in allAssets)
            {
                if (asset.id == vehicleId.Value)
                {
                    vehicleName = asset.FriendlyName;
                    break;
                }
            }

            // Сохраняем в базу данных
            VehicleData data = new VehicleData
            {
                GUID = vehicleGuid,
                vehicleID = vehicleId.Value,
                vehicleName = vehicleName,
                keyIDs = new List<ushort> { keyId }
            };
            Main.Database.SaveVehicle(data);

            // Выдаём ключ
            if (player.Player.inventory.tryAddItem(keyItem, true))
            {
                UnturnedChat.Say(caller, $"Транспорт '{vehicleName}' создан! Ключ выдан! GUID: {vehicleGuid}");
            }
            else
            {
                Vector3 spawnPosition = player.Player.transform.position + new Vector3(0f, 0.5f, 0f);
                ItemManager.dropItem(keyItem, spawnPosition, playEffect: true, isDropped: true, wideSpread: false);
                UnturnedChat.Say(caller, $"Транспорт '{vehicleName}' создан! Ключ выдан! GUID: {vehicleGuid}");
            }
        }
    }
}

using System.Collections.Generic;
using Rocket.API;
using Rocket.Unturned.Chat;
using Rocket.Unturned.Player;
