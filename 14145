using Rocket.API;
using Rocket.Core.Plugins;
using HarmonyLib;
using KRPCarKeys.Database;
using Rocket.Unturned.Player;
using SDG.Unturned;
using Steamworks;
using System.Collections.Generic;

namespace KRPCarKeys
{
    public class Main : RocketPlugin<Configuration>
    {
        public static Main Instance;
        public static VehicleDatabase Database;

        private Harmony _harmony;

        public static readonly ushort[] KeyIds = { 58124, 58125, 58126, 58127, 58128, 58129, 58130, 58131 };

        protected override void Load()
        {
            Instance = this;
            Database = new VehicleDatabase(Directory);

            _harmony = new Harmony("com.krp.carkeys");
            _harmony.PatchAll();

            Provider.onServerDisconnected += OnServerDisconnected;

            Rocket.Core.Logging.Logger.Log("[KRPCarKeys] Загружен! База данных инициализирована.");
        }

        private void OnServerDisconnected(CSteamID steamID)
        {
            if (steamID == CSteamID.Nil) return;

            UnturnedPlayer player = UnturnedPlayer.FromCSteamID(steamID);
            if (player == null || player.Player == null) return;

            InteractableVehicle vehicle = player.Player.movement.getVehicle();
            if (vehicle == null) return;

            // Ищем GUID в полях машины
            ulong guid = 0;
            if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
            {
                guid = vehicle.lockedOwner.m_SteamID;
            }
            else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
            {
                guid = vehicle.lockedGroup.m_SteamID;
            }

            if (guid == 0) return;

            // 🔥 Загружаем данные из БД (из кеша)
            VehicleData data = Main.Database.LoadVehicle(guid);
            if (data == null)
            {
                // Если данных нет — создаём новую запись (на случай, если машина была создана до рестарта)
                data = new VehicleData
                {
                    GUID = guid,
                    vehicleID = vehicle.asset?.id ?? 0,
                    vehicleName = vehicle.asset?.FriendlyName ?? "Unknown"
                };
            }

            // 🔥 Сохраняем финальное состояние машины
            data.health = vehicle.health;
            data.fuel = vehicle.fuel;
            data.battery = vehicle.batteryCharge;

            data.lastPosition = new Vector3Data
            {
                x = vehicle.transform.position.x,
                y = vehicle.transform.position.y,
                z = vehicle.transform.position.z
            };

            if (vehicle.tires != null)
            {
                data.wheels = new byte[vehicle.tires.Length];
                for (int i = 0; i < vehicle.tires.Length && i < 4; i++)
                {
                    data.wheels[i] = (byte)(vehicle.tires[i].isAlive ? 1 : 0);
                }
            }

            // 🔥 Сохраняем в БД (синхронно, мгновенно)
            Main.Database.SaveVehicle(data);
        }

        protected override void Unload()
        {
            Provider.onServerDisconnected -= OnServerDisconnected;

            _harmony?.UnpatchAll("com.krp.carkeys");

            // 🔥 Принудительно сохраняем все данные перед выгрузкой плагина
            Database?.ForceSaveAll();

            Rocket.Core.Logging.Logger.Log("[KRPCarKeys] Выгружен");
        }

        public static ulong GenerateGUID()
        {
            System.Random random = new System.Random();
            return (ulong)random.Next(1000000, 999999999);
        }

        public static bool IsOurGUID(ulong id)
        {
            return id >= 1000000 && id <= 999999999;
        }
    }
}


