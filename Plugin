namespace KRPCarKeys.Commands
{
    public class CommandParkEnter : IRocketCommand
    {
        public AllowedCaller AllowedCaller => AllowedCaller.Player;
        public string Name => "park";
        public string Help => "Вход в закрытый транспорт: /park enter";
        public string Syntax => "enter";
        public List<string> Aliases => new List<string>();
        public List<string> Permissions => new List<string> { "krpcarkeys.parkenter" };

        public void Execute(IRocketPlayer caller, string[] command)
        {
            UnturnedPlayer player = (UnturnedPlayer)caller;

            // Проверяем, что это команда /park enter
            if (command.Length == 0 || command[0].ToLower() != "enter")
            {
                UnturnedChat.Say(caller, "Использование: /park enter");
                return;
            }

            Vector3 origin = player.Player.look.aim.position - player.Player.look.aim.forward * 0.5f;
            Vector3 direction = player.Player.look.aim.forward;
            float distance = 4f;
            int layerMask = RayMasks.VEHICLE;

            RaycastHit hit;
            if (!Physics.Raycast(origin, direction, out hit, distance, layerMask))
            {
                UnturnedChat.Say(caller, "Смотрите на транспорт!");
                return;
            }

            InteractableVehicle vehicle = hit.transform.GetComponent<InteractableVehicle>();
            if (vehicle == null)
            {
                return;
            }

            if (vehicle.passengers == null || vehicle.passengers.Length == 0)
            {
                UnturnedChat.Say(caller, "В этом транспорте нет мест!");
                return;
            }

            if (vehicle.passengers[0].player != null)
            {
                if (vehicle.passengers[0].player.playerID.steamID == player.CSteamID)
                {
                    VehicleManager.forceRemovePlayer(vehicle, player.CSteamID);
                }
                else
                {
                    UnturnedChat.Say(caller, "Водительское место занято другим игроком!");
                    return;
                }
            }

            // 🔥 Принудительная синхронизация ТОЛЬКО если машина закрыта
            if (vehicle.isLocked)
            {
                VehicleManager.ServerSetVehicleLock(vehicle, vehicle.lockedOwner, vehicle.lockedGroup, false);
                VehicleManager.ServerSetVehicleLock(vehicle, vehicle.lockedOwner, vehicle.lockedGroup, true);
            }

            VehicleManager.ServerForcePassengerIntoVehicle(player.Player, vehicle);
            UnturnedChat.Say(caller, "Вы сели в транспорт!");
        }
    }
}

using Rocket.API;
using Rocket.Unturned.Chat;
using Rocket.Unturned.Player;
using SDG.Unturned;
using System;
using System.Collections.Generic;
using UnityEngine;
using KRPCarKeys.Database;

namespace KRPCarKeys.Commands
{
    public class CommandPointRestore : IRocketCommand
    {
        public AllowedCaller AllowedCaller => AllowedCaller.Player;
        public string Name => "pointrestore";
        public string Help => "Управление точками рестора: /pointrestore create/remove/list";
        public string Syntax => "create <name> X Y Z Rotation XLen YLen ZLen | remove <name> | list";
        public List<string> Aliases => new List<string>();
        public List<string> Permissions => new List<string> { "krpcarkeys.admin" };

        public void Execute(IRocketPlayer caller, string[] command)
        {
            if (command.Length == 0)
            {
                UnturnedChat.Say(caller, "Использование: /pointrestore create/remove/list");
                return;
            }

            string subCommand = command[0].ToLower();

            switch (subCommand)
            {
                case "create":
                    CreatePoint(caller, command);
                    break;

                case "remove":
                    RemovePoint(caller, command);
                    break;

                case "list":
                    ListPoints(caller);
                    break;

                default:
                    UnturnedChat.Say(caller, $"Неизвестная команда: /pointrestore {subCommand}");
                    break;
            }
        }

        private void CreatePoint(IRocketPlayer caller, string[] command)
        {
            // /pointrestore create <name> X Y Z Rotation XLen YLen ZLen
            if (command.Length != 9)
            {
                UnturnedChat.Say(caller, "Использование: /pointrestore create <name> X Y Z Rotation XLen YLen ZLen");
                return;
            }

            string name = command[1];

            if (!float.TryParse(command[2], out float x) ||
                !float.TryParse(command[3], out float y) ||
                !float.TryParse(command[4], out float z) ||
                !float.TryParse(command[5], out float rotation) ||
                !float.TryParse(command[6], out float xLen) ||
                !float.TryParse(command[7], out float yLen) ||
                !float.TryParse(command[8], out float zLen))
            {
                UnturnedChat.Say(caller, "Некорректные значения координат или размеров!");
                return;
            }

            // Проверяем, не существует ли уже точка с таким именем
            if (Main.RestoreDatabase.LoadPoint(name) != null)
            {
                UnturnedChat.Say(caller, $"Точка '{name}' уже существует!");
                return;
            }

            RestorePointData data = new RestorePointData
            {
                Name = name,
                Position = new RestorePosition { X = x, Y = y, Z = z },
                Rotation = rotation,
                Size = new RestoreSize { X = xLen, Y = yLen, Z = zLen }
            };

            Main.RestoreDatabase.SavePoint(data);
            UnturnedChat.Say(caller, $"Точка '{name}' создана!");
        }

        private void RemovePoint(IRocketPlayer caller, string[] command)
        {
            if (command.Length != 2)
            {
                UnturnedChat.Say(caller, "Использование: /pointrestore remove <name>");
                return;
            }

            string name = command[1];

            if (Main.RestoreDatabase.LoadPoint(name) == null)
            {
                UnturnedChat.Say(caller, $"Точка '{name}' не найдена!");
                return;
            }

            Main.RestoreDatabase.DeletePoint(name);
            UnturnedChat.Say(caller, $"Точка '{name}' удалена!");
        }

        private void ListPoints(IRocketPlayer caller)
        {
            var allData = Main.RestoreDatabase.GetAll();

            if (allData.Count == 0)
            {
                UnturnedChat.Say(caller, "Нет созданных точек!");
                return;
            }

            UnturnedChat.Say(caller, $"=== Точки рестора ({allData.Count}) ===");
            foreach (var kvp in allData)
            {
                var p = kvp.Value;
                UnturnedChat.Say(caller, $"{p.Name} — X:{p.Position.X:F1} Y:{p.Position.Y:F1} Z:{p.Position.Z:F1} | Поворот:{p.Rotation:F1}° | Размер:{p.Size.X}x{p.Size.Y}x{p.Size.Z}");
            }
        }
    }
}

using Rocket.API;
using Rocket.Unturned.Chat;
using Rocket.Unturned.Player;
using SDG.Unturned;
using Steamworks;
using System;
using System.Collections.Generic;
using UnityEngine;
using KRPCarKeys.Database;

namespace KRPCarKeys.Commands
{
    public class CommandV : IRocketCommand
    {
        public AllowedCaller AllowedCaller => AllowedCaller.Player;
        public string Name => "vehicle";
        public string Help => "Создаёт транспорт и ключ к нему!";
        public string Syntax => "<id или название>";
        public List<string> Aliases => new List<string> { "v" };
        public List<string> Permissions => new List<string> { "krpcarkeys.admin" };

        public void Execute(IRocketPlayer caller, string[] command)
        {
            UnturnedPlayer player = (UnturnedPlayer)caller;

            if (command.Length == 0)
            {
                UnturnedChat.Say(caller, "Использование: /v <id или название>");
                return;
            }

            ushort? vehicleId = null;
            string search = command[0];

            if (ushort.TryParse(search, out ushort id))
            {
                vehicleId = id;
            }
            else
            {
                List<VehicleAsset> assets = new List<VehicleAsset>();
                Assets.find(assets);

                foreach (VehicleAsset asset in assets)
                {
                    if (asset != null && asset.FriendlyName != null &&
                        asset.FriendlyName.ToLower().Contains(search.ToLower()))
                    {
                        vehicleId = asset.id;
                        break;
                    }
                }
            }

            if (!vehicleId.HasValue)
            {
                UnturnedChat.Say(caller, $"Транспорт '{search}' не найден!");
                return;
            }

            VehicleTool.giveVehicle(player.Player, vehicleId.Value);

            InteractableVehicle vehicle = null;
            var vehicles = VehicleManager.vehicles;
            if (vehicles.Count > 0)
            {
                vehicle = vehicles[vehicles.Count - 1];
            }

            if (vehicle == null)
            {
                UnturnedChat.Say(caller, "Ошибка: Транспорт не найден!");
                return;
            }

            ulong vehicleGuid = Main.GenerateGUID();

            VehicleManager.ServerSetVehicleLock(vehicle, new CSteamID(vehicleGuid), new CSteamID(vehicleGuid), true);

            ushort keyId = Main.KeyIds[new System.Random().Next(Main.KeyIds.Length)];
            byte[] keyData = BitConverter.GetBytes(vehicleGuid);
            Item keyItem = new Item(keyId, 1, 100, keyData);

            List<VehicleAsset> allAssets = new List<VehicleAsset>();
            Assets.find(allAssets);
            string vehicleName = "Unknown";
            foreach (VehicleAsset asset in allAssets)
            {
                if (asset.id == vehicleId.Value)
                {
                    vehicleName = asset.FriendlyName;
                    break;
                }
            }

            VehicleData data = new VehicleData
            {
                GUID = vehicleGuid,
                vehicleID = vehicleId.Value,
                vehicleName = vehicleName,
                instanceID = (int)vehicle.instanceID,
                OwnerID = player.CSteamID.ToString()  // 🔥 Истинный владелец
            };

            data.keys.Add(new KeyData
            {
                ID = keyId,
                Owner = player.CSteamID.ToString(),
                state = vehicleGuid
            });

            Main.Database.SaveVehicle(data);

            if (player.Player.inventory.tryAddItem(keyItem, true))
            {
                UnturnedChat.Say(caller, $"Транспорт '{vehicleName}' создан! Ключ выдан! GUID: {vehicleGuid}");
            }
            else
            {
                Vector3 spawnPosition = player.Player.transform.position + new Vector3(0f, 0.5f, 0f);
                ItemManager.dropItem(keyItem, spawnPosition, playEffect: true, isDropped: true, wideSpread: false);
                UnturnedChat.Say(caller, $"Транспорт '{vehicleName}' создан! Ключ выдан! GUID: {vehicleGuid}");
            }
        }
    }
}

using System.Collections.Generic;
