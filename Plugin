namespace KRPCarKeys.Database
{
    public class RestoreDatabase
    {
        private readonly string filePath;
        private Dictionary<string, RestorePointData> _cache;
        private readonly object _lock = new object();

        public RestoreDatabase(string pluginDirectory)
        {
            filePath = Path.Combine(pluginDirectory, "pointsrestore.json");
            _cache = new Dictionary<string, RestorePointData>();
            LoadAll();
        }

        public void LoadAll()
        {
            lock (_lock)
            {
                if (!File.Exists(filePath))
                {
                    _cache = new Dictionary<string, RestorePointData>();
                    return;
                }

                try
                {
                    string json = File.ReadAllText(filePath);
                    _cache = JsonConvert.DeserializeObject<Dictionary<string, RestorePointData>>(json)
                           ?? new Dictionary<string, RestorePointData>();
                }
                catch (Exception ex)
                {
                    Rocket.Core.Logging.Logger.Log($"[ERROR] RestoreDatabase.LoadAll: {ex.Message}");
                    _cache = new Dictionary<string, RestorePointData>();
                }
            }
        }

        public RestorePointData LoadPoint(string name)
        {
            lock (_lock)
            {
                return _cache.TryGetValue(name, out RestorePointData data) ? data : null;
            }
        }

        public void SavePoint(RestorePointData data)
        {
            if (data == null || string.IsNullOrEmpty(data.Name)) return;

            lock (_lock)
            {
                _cache[data.Name] = data;
                SaveAll();
            }
        }

        public void DeletePoint(string name)
        {
            lock (_lock)
            {
                if (_cache.Remove(name))
                {
                    SaveAll();
                }
            }
        }

        public Dictionary<string, RestorePointData> GetAll()
        {
            lock (_lock)
            {
                return new Dictionary<string, RestorePointData>(_cache);
            }
        }

        private void SaveAll()
        {
            try
            {
                string json = JsonConvert.SerializeObject(_cache, Formatting.Indented);
                File.WriteAllText(filePath, json);
            }
            catch (Exception ex)
            {
                Rocket.Core.Logging.Logger.Log($"[ERROR] RestoreDatabase.SaveAll: {ex.Message}");
            }
        }

        public void ForceSaveAll()
        {
            lock (_lock)
            {
                SaveAll();
            }
        }
    }
}

