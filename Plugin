using KRPCarKeys.Database;

namespace KRPCarKeys.Patches
{
    [HarmonyPatch(typeof(InteractableVehicle))]
    [HarmonyPatch("tellLocked")]
    internal class Patch_TellLocked
    {
        private static bool Prefix(InteractableVehicle __instance, ref CSteamID owner, ref CSteamID group, ref bool locked)
        {
            // 1. Ищем GUID в полях машины
            ulong currentGuid = 0;
            if (Main.IsOurGUID(__instance.lockedOwner.m_SteamID))
            {
                currentGuid = __instance.lockedOwner.m_SteamID;
            }
            else if (Main.IsOurGUID(__instance.lockedGroup.m_SteamID))
            {
                currentGuid = __instance.lockedGroup.m_SteamID;
            }

            // 2. Если GUID нет — ищем в БД по instanceID
            if (currentGuid == 0)
            {
                currentGuid = Main.Instance.FindGuidByInstanceID((int)__instance.instanceID);
            }

            // 3. Если GUID нет — выходим (машина без ключа)
            if (currentGuid == 0)
            {
                return true;
            }

            // 4. ОТКРЫТИЕ МАШИНЫ
            if (!locked)
            {
                owner = CSteamID.Nil;
                group = CSteamID.Nil;
                locked = false;
                return true;
            }

            // 5. ЗАКРЫТИЕ МАШИНЫ — ВСЕГДА используем GUID
            if (locked)
            {
                owner = new CSteamID(currentGuid);
                group = new CSteamID(currentGuid);
                locked = true;
                return true;
            }

            return true;
        }
    }
}

using HarmonyLib;
using KRPCarKeys.Database;
using Rocket.Unturned.Player;
using SDG.Unturned;
using Steamworks;
using System;
using System.Linq;
using UnityEngine;

namespace KRPCarKeys.Patches
{
    [HarmonyPatch(typeof(PlayerLife))]
    [HarmonyPatch("askEat")]
    internal class Patch_UseKey
    {
        private static void Prefix(PlayerLife __instance, byte amount)
        {
            if (__instance == null || __instance.player == null) return;

            Player player = __instance.player;
            if (player == null) return;

            PlayerEquipment equipment = player.equipment;
            if (equipment == null) return;

            ushort itemId = equipment.itemID;
            if (!Main.KeyIds.Contains(itemId))
            {
                return;
            }

            CSteamID steamID = player.channel.owner.playerID.steamID;
            UnturnedPlayer unturnedPlayer = UnturnedPlayer.FromCSteamID(steamID);
            if (unturnedPlayer == null) return;

            byte[] state = equipment.state;
            if (state == null || state.Length < 8)
            {
                return;
            }

            ulong keyGuid = BitConverter.ToUInt64(state, 0);
            if (!Main.IsOurGUID(keyGuid))
            {
                return;
            }

            Vector3 origin = player.look.aim.position - player.look.aim.forward * 0.5f;
            Vector3 direction = player.look.aim.forward;
            float distance = 4f;
            int layerMask = RayMasks.VEHICLE;

            RaycastHit hit;
            bool hitVehicle = Physics.Raycast(origin, direction, out hit, distance, layerMask);
            InteractableVehicle targetVehicle = null;
            bool isRemote = false;

            if (hitVehicle)
            {
                targetVehicle = hit.transform.GetComponent<InteractableVehicle>();
            }

            if (targetVehicle == null)
            {
                float searchRadius = 25f;
                Vector3 playerPos = player.transform.position;
                float closestDist = searchRadius + 1f;
                InteractableVehicle closestVehicle = null;

                foreach (var vehicle in VehicleManager.vehicles)
                {
                    ulong vGuid = 0;
                    if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
                    {
                        vGuid = vehicle.lockedOwner.m_SteamID;
                    }
                    else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
                    {
                        vGuid = vehicle.lockedGroup.m_SteamID;
                    }

                    if (vGuid != keyGuid)
                    {
                        ulong dbGuid = Main.Instance.FindGuidByInstanceID((int)vehicle.instanceID);
                        if (dbGuid != keyGuid) continue;
                    }

                    float dist = Vector3.Distance(playerPos, vehicle.transform.position);
                    if (dist < closestDist)
                    {
                        closestDist = dist;
                        closestVehicle = vehicle;
                    }
                }

                if (closestVehicle != null)
                {
                    targetVehicle = closestVehicle;
                    isRemote = true;
                }
                else
                {
                    Rocket.Unturned.Chat.UnturnedChat.Say(unturnedPlayer, "Транспорт не в зоне действия ключа!");
                    return;
                }
            }

            if (targetVehicle == null) return;

            bool hasFreeSeat = false;
            if (targetVehicle.passengers != null)
            {
                for (byte i = 0; i < targetVehicle.passengers.Length; i++)
                {
                    if (targetVehicle.passengers[i].player == null)
                    {
                        hasFreeSeat = true;
                        break;
                    }
                }
            }

            if (!hasFreeSeat)
            {
                Rocket.Unturned.Chat.UnturnedChat.Say(unturnedPlayer, "В этом транспорте нет свободных мест!");
                return;
            }

            ulong vehicleGuid = 0;
            if (Main.IsOurGUID(targetVehicle.lockedOwner.m_SteamID))
            {
                vehicleGuid = targetVehicle.lockedOwner.m_SteamID;
            }
            else if (Main.IsOurGUID(targetVehicle.lockedGroup.m_SteamID))
            {
                vehicleGuid = targetVehicle.lockedGroup.m_SteamID;
            }

            if (vehicleGuid == 0)
            {
                vehicleGuid = Main.Instance.FindGuidByInstanceID((int)targetVehicle.instanceID);
            }

            if (vehicleGuid != 0)
            {
                if (vehicleGuid != keyGuid)
                {
                    Rocket.Unturned.Chat.UnturnedChat.Say(unturnedPlayer, "Этот ключ не подходит к этому транспорту!");
                    return;
                }

                string steamId = steamID.ToString();
                VehicleData vehicleData = Main.Database.LoadVehicle(vehicleGuid);

                if (vehicleData != null)
                {
                    bool keyExists = false;
                    foreach (var keyData in vehicleData.keys)
                    {
                        if (keyData.state == vehicleGuid)
                        {
                            keyExists = true;
                            break;
                        }
                    }

                    if (!keyExists)
                    {
                        vehicleData.keys.Add(new KeyData
                        {
                            ID = itemId,
                            Owner = steamId,
                            state = vehicleGuid
                        });
                        Main.Database.SaveVehicle(vehicleData);
                    }
                }

                bool isLocked = Main.IsOurGUID(targetVehicle.lockedOwner.m_SteamID) || Main.IsOurGUID(targetVehicle.lockedGroup.m_SteamID);

                if (isRemote)
                {
                    string vehicleName = targetVehicle.asset?.FriendlyName ?? "Транспорт";

                    if (isLocked)
                    {
                        VehicleManager.ServerSetVehicleLock(targetVehicle, CSteamID.Nil, CSteamID.Nil, false);
                        Rocket.Unturned.Chat.UnturnedChat.Say(unturnedPlayer, $"{vehicleName} открыт дистанционно!");
                        PlayEffect(targetVehicle, 58461);
                    }
                    else
                    {
                        VehicleManager.ServerSetVehicleLock(targetVehicle, new CSteamID(vehicleGuid), new CSteamID(vehicleGuid), true);
                        Rocket.Unturned.Chat.UnturnedChat.Say(unturnedPlayer, $"{vehicleName} закрыт дистанционно!");
                        PlayEffect(targetVehicle, 58460);
                    }
                }
                else
                {
                    if (!isLocked)
                    {
                        VehicleManager.ServerSetVehicleLock(targetVehicle, new CSteamID(vehicleGuid), new CSteamID(vehicleGuid), true);
                    }

                    TryEnterVehicle(targetVehicle, unturnedPlayer);
                }

                return;
            }

            if (vehicleGuid == 0)
            {
                Rocket.Unturned.Chat.UnturnedChat.Say(unturnedPlayer, "Этот транспорт не имеет ключа!");
            }
        }

        private static void TryEnterVehicle(InteractableVehicle vehicle, UnturnedPlayer player)
        {
            if (vehicle == null || player == null) return;

            if (vehicle.passengers == null || vehicle.passengers.Length == 0)
            {
                return;
            }

            VehicleManager.ServerForcePassengerIntoVehicle(player.Player, vehicle);
        }

        private static void PlayEffect(InteractableVehicle vehicle, ushort effectID)
        {
            if (vehicle == null) return;

            EffectAsset effect = Assets.find(EAssetType.EFFECT, effectID) as EffectAsset;
            if (effect != null)
            {
                TriggerEffectParameters parameters = new TriggerEffectParameters(effect);
                parameters.position = vehicle.transform.position;
                parameters.relevantDistance = EffectManager.MEDIUM;
                parameters.reliable = true;
                EffectManager.triggerEffect(parameters);
            }
        }
    }
