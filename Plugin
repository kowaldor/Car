using KRPCarKeys.Database;
using Rocket.API;
using Rocket.Unturned.Chat;
using Rocket.Unturned.Player;
using SDG.Unturned;
using Steamworks;
using System;
using System.Collections.Generic;
using System.Linq;
using UnityEngine;

namespace KRPCarKeys.Commands
{
    public class CommandCar : IRocketCommand
    {
        public AllowedCaller AllowedCaller => AllowedCaller.Player;
        public string Name => "car";
        public string Help => "Команды для управления машиной: /car gps, /car makekey, /car relock, /car restore";
        public string Syntax => "gps | makekey";
        public List<string> Aliases => new List<string>();
        public List<string> Permissions => new List<string> { "krpcarkeys.user" };

        public void Execute(IRocketPlayer caller, string[] command)
        {
            UnturnedPlayer player = (UnturnedPlayer)caller;

            if (command.Length == 0)
            {
                UnturnedChat.Say(caller, "Использование: /car gps | /car makekey | /car relock | /car restore");
                return;
            }

            string subCommand = command[0].ToLower();

            switch (subCommand)
            {
                case "gps":
                    ExecuteGPS(player);
                    break;

                case "makekey":
                    ExecuteMakeKey(player);
                    break;

                case "restore":
                    ExecuteRestore(player);
                    break;

                case "relock":
                    ExecuteRelock(player);
                    break;

                default:
                    UnturnedChat.Say(caller, $"Неизвестная команда: /car {subCommand}. Используйте: gps, makekey, relock, restore");
                    break;
            }
        }

        // ==========================================
        // GPS маркер
        // ==========================================
        private void ExecuteGPS(UnturnedPlayer player)
        {
            ushort itemId = player.Player.equipment.itemID;
            byte[] state = player.Player.equipment.state;

            if (!Main.KeyIds.Contains(itemId) || state == null || state.Length < 8)
            {
                UnturnedChat.Say(player, "Возьмите ключ в руки!");
                return;
            }

            ulong guid = BitConverter.ToUInt64(state, 0);
            if (!Main.IsOurGUID(guid))
            {
                UnturnedChat.Say(player, "Ключ поврежден!");
                return;
            }

            InteractableVehicle targetVehicle = null;
            string vehicleName = "Транспорт";

            foreach (var vehicle in VehicleManager.vehicles)
            {
                ulong vehicleGuid = 0;
                if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
                {
                    vehicleGuid = vehicle.lockedOwner.m_SteamID;
                }
                else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
                {
                    vehicleGuid = vehicle.lockedGroup.m_SteamID;
                }

                if (vehicleGuid == guid)
                {
                    targetVehicle = vehicle;
                    vehicleName = vehicle.asset?.FriendlyName ?? "Транспорт";
                    break;
                }
            }

            if (targetVehicle == null)
            {
                UnturnedChat.Say(player, "Транспорт не найден в мире!");
                return;
            }

            player.Player.quests.replicateSetMarker(true, targetVehicle.transform.position, vehicleName);
            UnturnedChat.Say(player, $"GPS маркер '{vehicleName}' добавлен на карту!");
        }

        // ==========================================
        // Создание дубликата ключа
        // ==========================================
        private void ExecuteMakeKey(UnturnedPlayer player)
        {
            ushort itemId = player.Player.equipment.itemID;
            if (itemId != 58132)
            {
                UnturnedChat.Say(player, "Возьмите ключ-болванку в руку!");
                return;
            }

            Vector3 origin = player.Player.look.aim.position - player.Player.look.aim.forward * 0.5f;
            Vector3 direction = player.Player.look.aim.forward;
            float distance = 4f;
            int layerMask = RayMasks.VEHICLE;

            RaycastHit hit;
            if (!Physics.Raycast(origin, direction, out hit, distance, layerMask))
            {
                UnturnedChat.Say(player, "Смотрите на транспорт!");
                return;
            }

            InteractableVehicle targetVehicle = hit.transform.GetComponent<InteractableVehicle>();
            if (targetVehicle == null)
            {
                UnturnedChat.Say(player, "Это не транспорт!");
                return;
            }

            ulong vehicleGuid = 0;
            if (Main.IsOurGUID(targetVehicle.lockedOwner.m_SteamID))
            {
                vehicleGuid = targetVehicle.lockedOwner.m_SteamID;
            }
            else if (Main.IsOurGUID(targetVehicle.lockedGroup.m_SteamID))
            {
                vehicleGuid = targetVehicle.lockedGroup.m_SteamID;
            }

            if (vehicleGuid == 0)
            {
                vehicleGuid = Main.Instance.FindGuidByInstanceID((int)targetVehicle.instanceID);
            }

            if (vehicleGuid == 0)
            {
                UnturnedChat.Say(player, "Этот транспорт не имеет ключа!");
                return;
            }

            // Проверяем, есть ли у игрока ключ от этой машины в инвентаре
            bool hasKey = false;
            for (byte page = 0; page < player.Player.inventory.items.Length; page++)
            {
                var items = player.Player.inventory.items[page];
                if (items == null) continue;

                var itemList = items.items;
                if (itemList == null) continue;

                for (int i = 0; i < itemList.Count; i++)
                {
                    ItemJar jar = itemList[i];
                    if (jar == null || jar.item == null) continue;
                    if (!Main.KeyIds.Contains(jar.item.id)) continue;
                    if (jar.item.state == null || jar.item.state.Length < 8) continue;

                    ulong keyGuid = BitConverter.ToUInt64(jar.item.state, 0);
                    if (keyGuid == vehicleGuid)
                    {
                        hasKey = true;
                        break;
                    }
                }
                if (hasKey) break;
            }

            if (!hasKey)
            {
                UnturnedChat.Say(player, "У вас нет ключа от этого транспорта!");
                return;
            }

            // Удаляем болванку
            bool removed = false;
            for (byte page = 0; page < player.Player.inventory.items.Length; page++)
            {
                var items = player.Player.inventory.items[page];
                if (items == null) continue;

                var itemList = items.items;
                if (itemList == null) continue;

                for (int i = 0; i < itemList.Count; i++)
                {
                    ItemJar jar = itemList[i];
                    if (jar != null && jar.item.id == 58132)
                    {
                        player.Player.inventory.removeItem(page, (byte)i);
                        removed = true;
                        break;
                    }
                }
                if (removed) break;
            }

            if (!removed)
            {
                UnturnedChat.Say(player, "Ошибка! Ключ-болванка не найдена в инвентаре.");
                return;
            }

            // Создаём новый ключ
            ushort newKeyId = Main.KeyIds[new System.Random().Next(Main.KeyIds.Length)];
            byte[] keyData = BitConverter.GetBytes(vehicleGuid);
            Item keyItem = new Item(newKeyId, 1, 100, keyData);

            string vehicleName = targetVehicle.asset?.FriendlyName ?? "Транспорт";

            if (player.Player.inventory.tryAddItem(keyItem, true))
            {
                UnturnedChat.Say(player, $"Дубликат ключа от '{vehicleName}' создан!");
            }
            else
            {
                Vector3 spawnPosition = player.Player.transform.position + new Vector3(0f, 0.5f, 0f);
                ItemManager.dropItem(keyItem, spawnPosition, playEffect: true, isDropped: true, wideSpread: false);
                UnturnedChat.Say(player, $"Дубликат ключа от '{vehicleName}' создан!");
            }
        }

        // ==========================================
        // Смена замка (только для истинного владельца)
        // ==========================================
        private void ExecuteRelock(UnturnedPlayer player)
        {
            // 1. Проверяем ключ в руках
            ushort itemId = player.Player.equipment.itemID;
            if (!Main.KeyIds.Contains(itemId))
            {
                UnturnedChat.Say(player, "Возьмите ключ в руки!");
                return;
            }

            byte[] state = player.Player.equipment.state;
            if (state == null || state.Length < 8)
            {
                UnturnedChat.Say(player, "Ключ поврежден!");
                return;
            }

            ulong oldGuid = BitConverter.ToUInt64(state, 0);
            if (!Main.IsOurGUID(oldGuid))
            {
                UnturnedChat.Say(player, "Ключ поврежден!");
                return;
            }

            // 2. Ищем машину по рейкасту
            Vector3 origin = player.Player.look.aim.position - player.Player.look.aim.forward * 0.5f;
            Vector3 direction = player.Player.look.aim.forward;
            float distance = 4f;
            int layerMask = RayMasks.VEHICLE;

            RaycastHit hit;
            if (!Physics.Raycast(origin, direction, out hit, distance, layerMask))
            {
                UnturnedChat.Say(player, "Смотрите на транспорт!");
                return;
            }

            InteractableVehicle targetVehicle = hit.transform.GetComponent<InteractableVehicle>();
            if (targetVehicle == null)
            {
                UnturnedChat.Say(player, "Это не транспорт!");
                return;
            }

            // 3. Проверяем GUID машины
            ulong vehicleGuid = 0;
            if (Main.IsOurGUID(targetVehicle.lockedOwner.m_SteamID))
            {
                vehicleGuid = targetVehicle.lockedOwner.m_SteamID;
            }
            else if (Main.IsOurGUID(targetVehicle.lockedGroup.m_SteamID))
            {
                vehicleGuid = targetVehicle.lockedGroup.m_SteamID;
            }

            if (vehicleGuid == 0)
            {
                vehicleGuid = Main.Instance.FindGuidByInstanceID((int)targetVehicle.instanceID);
            }

            if (vehicleGuid == 0)
            {
                UnturnedChat.Say(player, "Этот транспорт не имеет ключа!");
                return;
            }

            // 4. Проверяем, что GUID из ключа совпадает с GUID машины
            if (vehicleGuid != oldGuid)
            {
                UnturnedChat.Say(player, "Этот ключ не подходит к этому транспорту!");
                return;
            }

            // 5. Проверяем, является ли игрок истинным владельцем
            VehicleData vehicleData = Main.Database.LoadVehicle(vehicleGuid);
            if (vehicleData == null)
            {
                UnturnedChat.Say(player, "Ошибка: данные о транспорте не найдены!");
                return;
            }

            string steamId = player.CSteamID.ToString();
            if (vehicleData.OwnerID != steamId)
            {
                UnturnedChat.Say(player, "Вы не являетесь владельцем этого транспорта!");
                return;
            }

            // 6. Генерируем новый GUID
            ulong newGuid = Main.GenerateGUID();

            // 7. 🔥 УДАЛЯЕМ СТАРУЮ ЗАПИСЬ
            Main.Database.DeleteVehicle(oldGuid);

            // 8. Обновляем данные и сохраняем с новым GUID
            VehicleData newData = new VehicleData
            {
                GUID = newGuid,
                vehicleID = vehicleData.vehicleID,
                vehicleName = vehicleData.vehicleName,
                instanceID = (int)targetVehicle.instanceID,  // ← УЖЕ СОХРАНЯЕМ!
                OwnerID = steamId,
                health = targetVehicle.health,
                fuel = targetVehicle.fuel,
                battery = targetVehicle.batteryCharge,
                lastPosition = new Vector3Data
                {
                    x = targetVehicle.transform.position.x,
                    y = targetVehicle.transform.position.y,
                    z = targetVehicle.transform.position.z
                }
            };

            if (targetVehicle.tires != null)
            {
                newData.wheels = new byte[targetVehicle.tires.Length];
                for (int i = 0; i < targetVehicle.tires.Length && i < 4; i++)
                {
                    newData.wheels[i] = (byte)(targetVehicle.tires[i].isAlive ? 1 : 0);
                }
            }

            // 🔥 ДОБАВЛЯЕМ ТОЛЬКО НОВЫЙ КЛЮЧ
            ushort newKeyId = Main.KeyIds[new System.Random().Next(Main.KeyIds.Length)];
            newData.keys.Add(new KeyData
            {
                ID = newKeyId,
                Owner = steamId,
                state = newGuid
            });

            // Сохраняем новую запись
            Main.Database.SaveVehicle(newData);

            // 🔥 ПРИНУДИТЕЛЬНАЯ СИНХРОНИЗАЦИЯ (добавляем!)
            VehicleManager.ServerSetVehicleLock(targetVehicle, new CSteamID(newGuid), new CSteamID(newGuid), true);
            VehicleManager.ServerSetVehicleLock(targetVehicle, targetVehicle.lockedOwner, targetVehicle.lockedGroup, false);
            VehicleManager.ServerSetVehicleLock(targetVehicle, targetVehicle.lockedOwner, targetVehicle.lockedGroup, true);

            // 10. Удаляем старый ключ из инвентаря
            bool removed = false;
            for (byte page = 0; page < player.Player.inventory.items.Length; page++)
            {
                var items = player.Player.inventory.items[page];
                if (items == null) continue;

                var itemList = items.items;
                if (itemList == null) continue;

                for (int i = 0; i < itemList.Count; i++)
                {
                    ItemJar jar = itemList[i];
                    if (jar == null || jar.item == null) continue;
                    if (!Main.KeyIds.Contains(jar.item.id)) continue;
                    if (jar.item.state == null || jar.item.state.Length < 8) continue;

                    ulong keyGuid = BitConverter.ToUInt64(jar.item.state, 0);
                    if (keyGuid == oldGuid)
                    {
                        player.Player.inventory.removeItem(page, (byte)i);
                        removed = true;
                        break;
                    }
                }
                if (removed) break;
            }

            if (!removed)
            {
                UnturnedChat.Say(player, "Ошибка! Старый ключ не найден в инвентаре!");
                return;
            }

            // 11. Создаём новый ключ
            byte[] newKeyData = BitConverter.GetBytes(newGuid);
            Item newKeyItem = new Item(newKeyId, 1, 100, newKeyData);

            string vehicleName = targetVehicle.asset?.FriendlyName ?? "Транспорт";

            if (player.Player.inventory.tryAddItem(newKeyItem, true))
            {
                UnturnedChat.Say(player, $"Вы сменили замок для '{vehicleName}'");
            }
            else
            {
                Vector3 spawnPosition = player.Player.transform.position + new Vector3(0f, 0.5f, 0f);
                ItemManager.dropItem(newKeyItem, spawnPosition, playEffect: true, isDropped: true, wideSpread: false);
                UnturnedChat.Say(player, $"Вы сменили замок для '{vehicleName}'");
            }
        }

        // ==========================================
        // Эвакуация машины (за 500 опыта)
        // ==========================================
        private void ExecuteRestore(UnturnedPlayer player)
        {
            // 1. Проверяем ключ в руках
            ushort itemId = player.Player.equipment.itemID;
            if (!Main.KeyIds.Contains(itemId))
            {
                UnturnedChat.Say(player, "Возьмите ключ в руки!");
                return;
            }

            byte[] state = player.Player.equipment.state;
            if (state == null || state.Length < 8)
            {
                UnturnedChat.Say(player, "Ключ поврежден!");
                return;
            }

            ulong guid = BitConverter.ToUInt64(state, 0);
            if (!Main.IsOurGUID(guid))
            {
                UnturnedChat.Say(player, "Ключ поврежден!");
                return;
            }

            // 2. Проверяем, есть ли у игрока 500 опыта
            if (player.Player.skills.experience < 500)
            {
                UnturnedChat.Say(player, "Недостаточно средств! Стоимость эвакуации - 500$.");
                return;
            }

            // 3. Ищем машину в мире
            InteractableVehicle targetVehicle = null;
            string vehicleName = "Транспорт";

            foreach (var vehicle in VehicleManager.vehicles)
            {
                ulong vehicleGuid = 0;
                if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
                {
                    vehicleGuid = vehicle.lockedOwner.m_SteamID;
                }
                else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
                {
                    vehicleGuid = vehicle.lockedGroup.m_SteamID;
                }

                if (vehicleGuid == guid)
                {
                    targetVehicle = vehicle;
                    vehicleName = vehicle.asset?.FriendlyName ?? "Транспорт";
                    break;
                }
            }

            // 🔥 Если не нашли по GUID — ищем по instanceID
            if (targetVehicle == null)
            {
                VehicleData data = Main.Database.LoadVehicle(guid);
                if (data != null)
                {
                    foreach (var vehicle in VehicleManager.vehicles)
                    {
                        if (data.instanceID == (int)vehicle.instanceID)
                        {
                            targetVehicle = vehicle;
                            vehicleName = vehicle.asset?.FriendlyName ?? "Транспорт";
                            break;
                        }
                    }
                }
            }

            if (targetVehicle == null)
            {
                UnturnedChat.Say(player, "Транспорт не найден в мире!");
                return;
            }

            // 4. Проверяем, есть ли пассажиры в машине
            if (targetVehicle.passengers != null)
            {
                foreach (var passenger in targetVehicle.passengers)
                {
                    if (passenger != null && passenger.player != null)
                    {
                        UnturnedChat.Say(player, "В транспорте есть пассажиры!");
                        return;
                    }
                }
            }

            // 5. Ищем свободную точку
            var allPoints = Main.RestoreDatabase.GetAll();
            if (allPoints.Count == 0)
            {
                UnturnedChat.Say(player, "Нет созданных точек для эвакуации!");
                return;
            }

            RestorePointData selectedPoint = null;
            foreach (var kvp in allPoints)
            {
                if (IsPointFree(kvp.Value))
                {
                    selectedPoint = kvp.Value;
                    break;
                }
            }

            if (selectedPoint == null)
            {
                UnturnedChat.Say(player, "Нет свободных мест!");
                return;
            }

            // 6. Снимаем опыт
            player.Player.skills.askSpend(500);

            // 7. Сохраняем и пересоздаём машину в новой точке
            Vector3 pos = new Vector3(selectedPoint.Position.X, selectedPoint.Position.Y, selectedPoint.Position.Z);
            Quaternion rot = Quaternion.Euler(0f, selectedPoint.Rotation, 0f);

            // 🔥 1. Загружаем и ОБНОВЛЯЕМ состояние машины
            VehicleData saveData = Main.Database.LoadVehicle(guid);
            if (saveData == null)
            {
                saveData = new VehicleData
                {
                    GUID = guid,
                    vehicleID = targetVehicle.asset?.id ?? 0,
                    vehicleName = targetVehicle.asset?.FriendlyName ?? "Unknown"
                };
            }

            // 🔥 Сохраняем текущее состояние из машины
            saveData.health = targetVehicle.health;
            saveData.fuel = targetVehicle.fuel;
            saveData.battery = targetVehicle.batteryCharge;
            saveData.lastPosition = new Vector3Data
            {
                x = targetVehicle.transform.position.x,
                y = targetVehicle.transform.position.y,
                z = targetVehicle.transform.position.z
            };

            // 🔥 Сохраняем колёса (битовая маска)
            saveData.wheels = new byte[] { targetVehicle.tireAliveMask };

            // 🔥 Сохраняем багаж (с полным именем ItemData)
            saveData.baggage.Clear();
            if (targetVehicle.trunkItems != null)
            {
                for (byte i = 0; i < targetVehicle.trunkItems.getItemCount(); i++)
                {
                    ItemJar jar = targetVehicle.trunkItems.getItem(i);
                    if (jar != null && jar.item != null)
                    {
                        KRPCarKeys.Database.ItemData itemData = new KRPCarKeys.Database.ItemData
                        {
                            itemID = jar.item.id,
                            amount = jar.item.amount,
                            quality = jar.item.quality,
                            state = jar.item.state,
                            x = jar.x,
                            y = jar.y,
                            rot = jar.rot
                        };

                        saveData.baggage.Add(itemData);
                    }
                }
            }

            // 🔥 Сохраняем в БД перед удалением
            Main.Database.SaveVehicle(saveData);

            // ==========================================
            // 🔥 ОЧИЩАЕМ БАГАЖНИК, ЧТОБЫ ПРЕДМЕТЫ НЕ ВЫПАЛИ
            // ==========================================
            if (targetVehicle.trunkItems != null)
            {
                // Удаляем все предметы из багажника
                while (targetVehicle.trunkItems.getItemCount() > 0)
                {
                    targetVehicle.trunkItems.removeItem(0);
                }
            }

            // 2. Удаляем старую машину
            VehicleManager.askVehicleDestroy(targetVehicle);

            // 3. Создаём новую машину в нужной точке
            InteractableVehicle newVehicle = VehicleManager.spawnVehicleV2(saveData.vehicleID, pos, rot);
            if (newVehicle == null)
            {
                UnturnedChat.Say(player, "Ошибка при создании машины!");
                return;
            }

            // 4. Блокируем новую машину под GUID
            VehicleManager.ServerSetVehicleLock(newVehicle, new CSteamID(guid), new CSteamID(guid), true);

            // 5. Восстанавливаем состояние (из обновлённого saveData)
            newVehicle.health = saveData.health;
            newVehicle.fuel = saveData.fuel;
            newVehicle.batteryCharge = saveData.battery;
            VehicleManager.sendVehicleHealth(newVehicle, saveData.health);
            VehicleManager.sendVehicleFuel(newVehicle, saveData.fuel);
            VehicleManager.sendVehicleBatteryCharge(newVehicle, saveData.battery);


            // 🔥 Восстанавливаем колёса
            if (saveData.wheels != null && saveData.wheels.Length > 0)
            {
                newVehicle.tireAliveMask = saveData.wheels[0];
                VehicleManager.sendVehicleTireAliveMask(newVehicle, saveData.wheels[0]);
            }

            // 🔥 Восстанавливаем багаж
            if (saveData.baggage != null && saveData.baggage.Count > 0)
            {
                // Создаём новый trunkItems
                if (newVehicle.trunkItems == null)
                {
                    newVehicle.trunkItems = new Items(7); // 7 = STORAGE
                }

                // Добавляем предметы в багажник
                foreach (var itemData in saveData.baggage)
                {
                    if (itemData == null) continue;

                    Item item = new Item(itemData.itemID, itemData.amount, itemData.quality, itemData.state);
                    newVehicle.trunkItems.addItem(itemData.x, itemData.y, itemData.rot, item);
                }
            }

            // 6. Обновляем instanceID в БД
            saveData.instanceID = (int)newVehicle.instanceID;
            Main.Database.SaveVehicle(saveData);

            // 7. Синхронизация для НОВОЙ машины
            newVehicle.MarkForReplicationUpdate();
            VehicleManager.ServerSetVehicleLock(newVehicle, newVehicle.lockedOwner, newVehicle.lockedGroup, newVehicle.isLocked);

            UnturnedChat.Say(player, $"Транспорт '{saveData.vehicleName}' эвакуирован на штраф-стоянку г.Волково!");
        }

        // ==========================================
        // Проверка, свободна ли точка
        // ==========================================
        private bool IsPointFree(RestorePointData point)
        {
            Vector3 center = new Vector3(point.Position.X, point.Position.Y, point.Position.Z);
            Vector3 halfSize = new Vector3(point.Size.X / 2f, point.Size.Y / 2f, point.Size.Z / 2f);

            // 🔥 Маска слоёв: машины, игроки, баррикады
            int layerMask = RayMasks.VEHICLE | RayMasks.PLAYER | RayMasks.BARRICADE;

            // 🔥 Проверяем, есть ли что-то в прямоугольнике
            if (Physics.CheckBox(center, halfSize, Quaternion.identity, layerMask))
            {
                return false; // Есть что-то → точка занята
            }

            return true; // Точка свободна
        }
    }
}

