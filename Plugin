        [JsonProperty("state")]
        public ulong state { get; set; }

        public KeyData()
        {
            Owner = "";
            state = 0;
        }
    }
}

using System;
using System.Collections.Generic;
using System.IO;
using Newtonsoft.Json;

namespace KRPCarKeys.Database
{
    public class VehicleDatabase
    {
        private readonly string filePath;
        private Dictionary<ulong, VehicleData> _cache;
        private readonly object _lock = new object();

        public VehicleDatabase(string pluginDirectory)
        {
            filePath = Path.Combine(pluginDirectory, "vehicles.json");
            _cache = new Dictionary<ulong, VehicleData>();
            LoadAll();
        }

        public void LoadAll()
        {
            lock (_lock)
            {
                if (!File.Exists(filePath))
                {
                    _cache = new Dictionary<ulong, VehicleData>();
                    return;
                }

                try
                {
                    string json = File.ReadAllText(filePath);
                    _cache = JsonConvert.DeserializeObject<Dictionary<ulong, VehicleData>>(json)
                           ?? new Dictionary<ulong, VehicleData>();
                }
                catch (Exception ex)
                {
                    Rocket.Core.Logging.Logger.Log($"[ERROR] LoadAll: {ex.Message}");
                    _cache = new Dictionary<ulong, VehicleData>();
                }
            }
        }

        public VehicleData LoadVehicle(ulong guid)
        {
            lock (_lock)
            {
                return _cache.TryGetValue(guid, out VehicleData data) ? data : null;
            }
        }

        public void SaveVehicle(VehicleData data)
        {
            if (data == null) return;

            lock (_lock)
            {
                _cache[data.GUID] = data;
                SaveAll();
            }
        }

        public void DeleteVehicle(ulong guid)
        {
            lock (_lock)
            {
                if (_cache.Remove(guid))
                {
                    SaveAll();
                }
            }
        }

        private void SaveAll()
        {
            try
            {
                string json = JsonConvert.SerializeObject(_cache, Formatting.Indented);
                File.WriteAllText(filePath, json);
            }
            catch (Exception ex)
            {
                Rocket.Core.Logging.Logger.Log($"[ERROR] SaveAll: {ex.Message}");
            }
        }

        public void ForceSaveAll()
        {
            lock (_lock)
            {
                SaveAll();
            }
        }

        public Dictionary<ulong, VehicleData> GetAll()
        {
            lock (_lock)
            {
                return new Dictionary<ulong, VehicleData>(_cache);
            }
        }

        // 🔥 НОВЫЙ МЕТОД: Поиск GUID по instanceID без копирования словаря
        public ulong GetGuidByInstanceID(int instanceID)
        {
            lock (_lock)
            {
                foreach (var kvp in _cache)
                {
                    if (kvp.Value.instanceID == instanceID)
                    {
                        return kvp.Key;
                    }
                }
                return 0;
            }
        }
    }
}

