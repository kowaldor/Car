        {
            baggage = new List<ItemData>();
            wheels = new byte[4];
            keys = new List<KeyData>();
            steamID = "";
            licensePlate = "";
            instanceID = 0;
        }
    }

    public class Vector3Data
    {
        public float x { get; set; }
        public float y { get; set; }
        public float z { get; set; }
    }

