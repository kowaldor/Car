namespace KRPCarKeys.Commands
{
    public class CommandCarGPS : IRocketCommand
    {
        public AllowedCaller AllowedCaller => AllowedCaller.Player;
        public string Name => "car";
        public string Help => "Для использования GPS маркера используйте команду: /car gps";
        public string Syntax => "gps";
        public List<string> Aliases => new List<string>();
        public List<string> Permissions => new List<string> { "krpcarkeys.user" };

        public void Execute(IRocketPlayer caller, string[] command)
        {
            UnturnedPlayer player = (UnturnedPlayer)caller;

            if (command.Length == 0 || command[0].ToLower() != "gps")
            {
                UnturnedChat.Say(caller, "Использование: /car gps");
                return;
            }

            ushort itemId = player.Player.equipment.itemID;
            byte[] state = player.Player.equipment.state;

            if (!Main.KeyIds.Contains(itemId) || state == null || state.Length < 8)
            {
                UnturnedChat.Say(caller, "Возьмите ключ в руки!");
                return;
            }

            ulong guid = BitConverter.ToUInt64(state, 0);
            if (!Main.IsOurGUID(guid))
            {
                UnturnedChat.Say(caller, "Ключ поврежден!");
                return;
            }

            InteractableVehicle targetVehicle = null;
            string vehicleName = "Транспорт";

            foreach (var vehicle in VehicleManager.vehicles)
            {
                ulong vehicleGuid = 0;
                if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
                {
                    vehicleGuid = vehicle.lockedOwner.m_SteamID;
                }
                else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
                {
                    vehicleGuid = vehicle.lockedGroup.m_SteamID;
                }

                if (vehicleGuid == guid)
                {
                    targetVehicle = vehicle;
                    vehicleName = vehicle.asset?.FriendlyName ?? "Транспорт";
                    break;
                }
            }

            if (targetVehicle == null)
            {
                UnturnedChat.Say(caller, "Машина не найдена в мире!");
                return;
            }

            player.Player.quests.replicateSetMarker(true, targetVehicle.transform.position, vehicleName);
            UnturnedChat.Say(caller, $"GPS маркер '{vehicleName}' добавлен на карту!");
        }
    }
}

