namespace KRPCarKeys.Commands
{
    public class CommandCarInfo : IRocketCommand
    {
        public AllowedCaller AllowedCaller => AllowedCaller.Player;
        public string Name => "carinfo";
        public string Help => "Показывает информацию о транспорте";
        public string Syntax => "";
        public List<string> Aliases => new List<string>();
        public List<string> Permissions => new List<string> { "krpcarkeys.admin" };

        public void Execute(IRocketPlayer caller, string[] command)
        {
            UnturnedPlayer player = (UnturnedPlayer)caller;

            Vector3 origin = player.Player.look.aim.position - player.Player.look.aim.forward * 0.5f;
            Vector3 direction = player.Player.look.aim.forward;
            float distance = 4f;
            int layerMask = RayMasks.VEHICLE;

            RaycastHit hit;
            if (!Physics.Raycast(origin, direction, out hit, distance, layerMask))
            {
                UnturnedChat.Say(caller, "Смотрите на транспорт!");
                return;
            }

            InteractableVehicle vehicle = hit.transform.GetComponent<InteractableVehicle>();
            if (vehicle == null)
            {
                return;
            }

            // Ищем GUID в полях машины
            ulong guid = 0;
            if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
            {
                guid = vehicle.lockedOwner.m_SteamID;
            }
            else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
            {
                guid = vehicle.lockedGroup.m_SteamID;
            }

            // Если GUID не найден в полях — ищем в БД по instanceID
            if (guid == 0)
            {
                var allData = Main.Database.GetAll();
                foreach (var kvp in allData)
                {
                    if (kvp.Value.instanceID == (int)vehicle.instanceID)
                    {
                        guid = kvp.Key;
                        break;
                    }
                }
            }

            string vehicleName = vehicle.asset?.FriendlyName ?? "Unknown";
            ushort vehicleId = vehicle.asset?.id ?? 0;

            if (guid != 0)
            {
                UnturnedChat.Say(caller, $"ID: {vehicleId} | Название: {vehicleName} | instanceID: {vehicle.instanceID} | GUID: {guid}");
            }
            else
            {
                UnturnedChat.Say(caller, $"ID: {vehicleId} | Название: {vehicleName} | instanceID: {vehicle.instanceID} | GUID не найден");
            }
        }
    }
}

using KRPCarKeys.Database;
using Rocket.API;
using Rocket.Unturned.Chat;
using Rocket.Unturned.Player;
using SDG.Unturned;
using Steamworks;
using System;
using System.Collections.Generic;
using System.Linq;
using UnityEngine;

namespace KRPCarKeys.Commands
{
    public class CommandCarMakeKey : IRocketCommand
    {
        public AllowedCaller AllowedCaller => AllowedCaller.Player;
        public string Name => "car";
        public string Help => "Для создания дубликата ключа используйте: /car makekey, держа ключ-болванку в руке и смотря на машину";
        public string Syntax => "makekey";
        public List<string> Aliases => new List<string>();
        public List<string> Permissions => new List<string> { "krpcarkeys.user" };

        public void Execute(IRocketPlayer caller, string[] command)
        {
            UnturnedPlayer player = (UnturnedPlayer)caller;

            if (command.Length == 0 || command[0].ToLower() != "makekey")
            {
                UnturnedChat.Say(caller, "Использование: /car makekey");
                return;
            }

            ushort itemId = player.Player.equipment.itemID;
            if (itemId != 58132)
            {
                UnturnedChat.Say(caller, "Возьмите ключ-болванку в руку!");
                return;
            }

            Vector3 origin = player.Player.look.aim.position - player.Player.look.aim.forward * 0.5f;
            Vector3 direction = player.Player.look.aim.forward;
            float distance = 4f;
            int layerMask = RayMasks.VEHICLE;

            RaycastHit hit;
            if (!Physics.Raycast(origin, direction, out hit, distance, layerMask))
            {
                UnturnedChat.Say(caller, "Смотрите на транспорт!");
                return;
            }

            InteractableVehicle targetVehicle = hit.transform.GetComponent<InteractableVehicle>();
            if (targetVehicle == null)
            {
                UnturnedChat.Say(caller, "Это не транспорт!");
                return;
            }

            ulong vehicleGuid = 0;
            if (Main.IsOurGUID(targetVehicle.lockedOwner.m_SteamID))
            {
                vehicleGuid = targetVehicle.lockedOwner.m_SteamID;
            }
            else if (Main.IsOurGUID(targetVehicle.lockedGroup.m_SteamID))
            {
                vehicleGuid = targetVehicle.lockedGroup.m_SteamID;
            }

            if (vehicleGuid == 0)
            {
                vehicleGuid = Main.Instance.FindGuidByInstanceID((int)targetVehicle.instanceID);
            }

            if (vehicleGuid == 0)
            {
                UnturnedChat.Say(caller, "Этот транспорт не имеет ключа!");
                return;
            }

            // Проверяем, есть ли у игрока ключ от этой машины в инвентаре
            bool hasKey = false;
            for (byte page = 0; page < player.Player.inventory.items.Length; page++)
            {
                var items = player.Player.inventory.items[page];
                if (items == null) continue;

                var itemList = items.items;
                if (itemList == null) continue;

                for (int i = 0; i < itemList.Count; i++)
                {
                    ItemJar jar = itemList[i];
                    if (jar == null || jar.item == null) continue;
                    if (!Main.KeyIds.Contains(jar.item.id)) continue;
                    if (jar.item.state == null || jar.item.state.Length < 8) continue;

                    ulong keyGuid = BitConverter.ToUInt64(jar.item.state, 0);
                    if (keyGuid == vehicleGuid)
                    {
                        hasKey = true;
                        break;
                    }
                }
                if (hasKey) break;
            }

            if (!hasKey)
            {
                UnturnedChat.Say(caller, "У вас нет ключа от этого транспорта!");
                return;
            }

            // Удаляем болванку
            bool removed = false;
            for (byte page = 0; page < player.Player.inventory.items.Length; page++)
            {
                var items = player.Player.inventory.items[page];
                if (items == null) continue;

                var itemList = items.items;
                if (itemList == null) continue;

                for (int i = 0; i < itemList.Count; i++)
                {
                    ItemJar jar = itemList[i];
                    if (jar != null && jar.item.id == 58132)
                    {
                        player.Player.inventory.removeItem(page, (byte)i);
                        removed = true;
                        break;
                    }
                }
                if (removed) break;
            }

            if (!removed)
            {
                UnturnedChat.Say(caller, "Ошибка! Ключ-болванка не найдена в инвентаре.");
                return;
            }

            // Создаём новый ключ
            ushort newKeyId = Main.KeyIds[new System.Random().Next(Main.KeyIds.Length)];
            byte[] keyData = BitConverter.GetBytes(vehicleGuid);
            Item keyItem = new Item(newKeyId, 1, 100, keyData);

            string vehicleName = targetVehicle.asset?.FriendlyName ?? "Транспорт";

            if (player.Player.inventory.tryAddItem(keyItem, true))
            {
                UnturnedChat.Say(caller, $"Дубликат ключа от '{vehicleName}' создан!");
            }
            else
            {
                Vector3 spawnPosition = player.Player.transform.position + new Vector3(0f, 0.5f, 0f);
                ItemManager.dropItem(keyItem, spawnPosition, playEffect: true, isDropped: true, wideSpread: false);
                UnturnedChat.Say(caller, $"Дубликат ключа от '{vehicleName}' создан!");
            }
        }
    }
}

using Rocket.API;
using Rocket.Unturned.Chat;
using Rocket.Unturned.Player;
using SDG.Unturned;
using System.Collections.Generic;
using UnityEngine;

namespace KRPCarKeys.Commands
{
    public class CommandParkEnter : IRocketCommand
    {
        public AllowedCaller AllowedCaller => AllowedCaller.Player;
        public string Name => "parkenter";
        public string Help => "Вход в закрытый транспорт";
        public string Syntax => "";
        public List<string> Aliases => new List<string>();
        public List<string> Permissions => new List<string> { "krpcarkeys.parkenter" };

        public void Execute(IRocketPlayer caller, string[] command)
        {
            UnturnedPlayer player = (UnturnedPlayer)caller;

            // Рейкаст с коррекцией (луч позади игрока)
            Vector3 origin = player.Player.look.aim.position - player.Player.look.aim.forward * 0.5f;
            Vector3 direction = player.Player.look.aim.forward;
            float distance = 4f;

            // Используем маску только для машин (слой 13)
            int layerMask = RayMasks.VEHICLE; // 67108864

            RaycastHit hit;
            if (!Physics.Raycast(origin, direction, out hit, distance, layerMask))
            {
                UnturnedChat.Say(caller, "Смотрите на транспорт!");
                return;
            }

            InteractableVehicle vehicle = hit.transform.GetComponent<InteractableVehicle>();
            if (vehicle == null)
            {
                return;
            }

            // Проверяем, есть ли места в машине
            if (vehicle.passengers == null || vehicle.passengers.Length == 0)
            {
                UnturnedChat.Say(caller, "В этом транспорте нет мест!");
                return;
            }

            // Проверяем, занято ли водительское место
            if (vehicle.passengers[0].player != null)
            {
                if (vehicle.passengers[0].player.playerID.steamID == player.CSteamID)
                {
                    VehicleManager.forceRemovePlayer(vehicle, player.CSteamID);
                }
                else
                {
                    UnturnedChat.Say(caller, "Водительское место занято другим игроком!");
                    return;
                }
            }

            // Принудительная синхронизация перед посадкой
            VehicleManager.ServerSetVehicleLock(vehicle, vehicle.lockedOwner, vehicle.lockedGroup, false);
            VehicleManager.ServerSetVehicleLock(vehicle, vehicle.lockedOwner, vehicle.lockedGroup, true);

            // Сажаем игрока за руль
            VehicleManager.ServerForcePassengerIntoVehicle(player.Player, vehicle);

            UnturnedChat.Say(caller, "Вы сели в транспорт!");
        }
    }
}

