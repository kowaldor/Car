        public string Name => "vehicle";
        public string Help => "Создаёт транспорт и ключ к нему!";
        public string Syntax => "<id или название>";
        public List<string> Aliases => new List<string> { "v" };
        public List<string> Permissions => new List<string> { "krpcarkeys.admin" };

        public void Execute(IRocketPlayer caller, string[] command)
        {
            UnturnedPlayer player = (UnturnedPlayer)caller;

            if (command.Length == 0)
            {
                UnturnedChat.Say(caller, "Использование: /v <id или название>");
                return;
            }

            ushort? vehicleId = null;
            string search = command[0];

            if (ushort.TryParse(search, out ushort id))
            {
                vehicleId = id;
            }
            else
            {
                List<VehicleAsset> assets = new List<VehicleAsset>();
                Assets.find(assets);

                foreach (VehicleAsset asset in assets)
                {
                    if (asset != null && asset.FriendlyName != null &&
                        asset.FriendlyName.ToLower().Contains(search.ToLower()))
                    {
                        vehicleId = asset.id;
                        break;
                    }
                }
            }

            if (!vehicleId.HasValue)
            {
                UnturnedChat.Say(caller, $"Транспорт '{search}' не найден!");
                return;
            }

            VehicleTool.giveVehicle(player.Player, vehicleId.Value);

            InteractableVehicle vehicle = null;
            var vehicles = VehicleManager.vehicles;
            if (vehicles.Count > 0)
            {
                vehicle = vehicles[vehicles.Count - 1];
            }

            if (vehicle == null)
            {
                UnturnedChat.Say(caller, "Ошибка: Транспорт не найден!");
                return;
            }

            ulong vehicleGuid = Main.GenerateGUID();

            VehicleManager.ServerSetVehicleLock(vehicle, new CSteamID(vehicleGuid), new CSteamID(vehicleGuid), true);

            ushort keyId = Main.KeyIds[new System.Random().Next(Main.KeyIds.Length)];
            byte[] keyData = BitConverter.GetBytes(vehicleGuid);
            Item keyItem = new Item(keyId, 1, 100, keyData);

            List<VehicleAsset> allAssets = new List<VehicleAsset>();
            Assets.find(allAssets);
            string vehicleName = "Unknown";
            foreach (VehicleAsset asset in allAssets)
            {
                if (asset.id == vehicleId.Value)
                {
                    vehicleName = asset.FriendlyName;
                    break;
                }
            }

            VehicleData data = new VehicleData
            {
                GUID = vehicleGuid,
                vehicleID = vehicleId.Value,
                vehicleName = vehicleName,
                instanceID = (int)vehicle.instanceID
            };

            data.keys.Add(new KeyData
            {
                ID = keyId,
                Owner = player.CSteamID.ToString(),
                state = vehicleGuid
            });

            Main.Database.SaveVehicle(data);

            if (player.Player.inventory.tryAddItem(keyItem, true))
            {
                UnturnedChat.Say(caller, $"Транспорт '{vehicleName}' создан! Ключ выдан! GUID: {vehicleGuid}");
            }
            else
            {
                Vector3 spawnPosition = player.Player.transform.position + new Vector3(0f, 0.5f, 0f);
                ItemManager.dropItem(keyItem, spawnPosition, playEffect: true, isDropped: true, wideSpread: false);
                UnturnedChat.Say(caller, $"Транспорт '{vehicleName}' создан! Ключ выдан! GUID: {vehicleGuid}");
            }
        }
    }
}

using System.Collections.Generic;
using Rocket.API;
using Rocket.Unturned.Chat;
using Rocket.Unturned.Player;
using SDG.Unturned;
using UnityEngine;
using KRPCarKeys.Database;

namespace KRPCarKeys.Commands
{
    public class CommandVD : IRocketCommand
    {
        public AllowedCaller AllowedCaller => AllowedCaller.Player;
        public string Name => "vehicledestroy";
        public string Help => "Удаляет транспорт, на который смотришь";
        public string Syntax => "";
        public List<string> Aliases => new List<string> { "vd" };
        public List<string> Permissions => new List<string> { "krpcarkeys.admin" };

        public void Execute(IRocketPlayer caller, string[] command)
        {
            UnturnedPlayer player = (UnturnedPlayer)caller;

            Vector3 origin = player.Player.look.aim.position - player.Player.look.aim.forward * 0.5f;
            Vector3 direction = player.Player.look.aim.forward;
            float distance = 4f;

            int layerMask = RayMasks.VEHICLE;

            RaycastHit hit;
            if (!Physics.Raycast(origin, direction, out hit, distance, layerMask))
            {
                UnturnedChat.Say(caller, "Смотрите на транспорт!");
                return;
            }

            InteractableVehicle vehicle = hit.transform.GetComponent<InteractableVehicle>();
            if (vehicle == null)
            {
                return;
            }

            // Проверка: есть ли кто-то в машине
            if (vehicle.passengers != null)
            {
                foreach (Passenger passenger in vehicle.passengers)
                {
                    if (passenger != null && passenger.player != null)
                    {
                        UnturnedChat.Say(caller, "Нельзя удалить транспорт с игроком внутри!");
                        return;
                    }
                }
            }

            // ==========================================
            // 1. Ищем GUID в полях машины
            // ==========================================
            ulong guid = 0;
            if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
            {
                guid = vehicle.lockedOwner.m_SteamID;
            }
            else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
            {
                guid = vehicle.lockedGroup.m_SteamID;
            }

            // ==========================================
            // 2. Если не нашли — ищем в БД по instanceID
            // ==========================================
            if (guid == 0)
            {
                guid = Main.Instance.FindGuidByInstanceID((int)vehicle.instanceID);
            }

            // ==========================================
            // 3. Если GUID найден — удаляем из БД
            // ==========================================
            if (guid != 0)
            {
                Main.Database.DeleteVehicle(guid);
            }

            // Эффекты при удалении (ID 19, 69, 138)
            Vector3 position = vehicle.transform.position;

            EffectAsset effect19 = Assets.find(EAssetType.EFFECT, 19) as EffectAsset;
            EffectAsset effect69 = Assets.find(EAssetType.EFFECT, 69) as EffectAsset;
            EffectAsset effect138 = Assets.find(EAssetType.EFFECT, 138) as EffectAsset;

            if (effect19 != null)
            {
                TriggerEffectParameters parameters = new TriggerEffectParameters(effect19);
                parameters.position = position;
                parameters.relevantDistance = EffectManager.LARGE;
                parameters.reliable = true;
                EffectManager.triggerEffect(parameters);
            }

            if (effect69 != null)
            {
                TriggerEffectParameters parameters = new TriggerEffectParameters(effect69);
                parameters.position = position;
                parameters.relevantDistance = EffectManager.LARGE;
                parameters.reliable = true;
                EffectManager.triggerEffect(parameters);
            }

            if (effect138 != null)
            {
                TriggerEffectParameters parameters = new TriggerEffectParameters(effect138);
                parameters.position = position;
                parameters.relevantDistance = EffectManager.LARGE;
                parameters.reliable = true;
                EffectManager.triggerEffect(parameters);
            }

            VehicleManager.askVehicleDestroy(vehicle);
            UnturnedChat.Say(caller, $"Транспорт {vehicle.asset?.FriendlyName ?? "Unknown"} удален!");
        }
    }
}

using System.Collections.Generic;
using Newtonsoft.Json;

namespace KRPCarKeys.Database
{
    public class VehicleData
    {
        [JsonProperty("GUID")]
        public ulong GUID { get; set; }

        [JsonProperty("vehicleID")]
        public ushort vehicleID { get; set; }

        [JsonProperty("vehicleName")]
        public string vehicleName { get; set; }

        // === Временный ID для связи с игрой ===
        [JsonProperty("instanceID")]
        public int instanceID { get; set; }

        // === Владелец (для будущего) ===
        [JsonProperty("steamID")]
        public string steamID { get; set; }

        [JsonProperty("licensePlate")]
        public string licensePlate { get; set; }

        // === Состояние машины ===
        [JsonProperty("health")]
        public ushort health { get; set; }

        [JsonProperty("battery")]
        public ushort battery { get; set; }

        [JsonProperty("fuel")]
        public ushort fuel { get; set; }

        [JsonProperty("wheels")]
        public byte[] wheels { get; set; }

        [JsonProperty("lastPosition")]
        public Vector3Data lastPosition { get; set; }

        [JsonProperty("baggage")]
        public List<ItemData> baggage { get; set; }

        // === Ключи (отдельная таблица) ===
        [JsonProperty("keys")]
        public List<KeyData> keys { get; set; }

