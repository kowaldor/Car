using HarmonyLib;
using KRPCarKeys.Database;
using Rocket.API;
using Rocket.Core.Plugins;
using Rocket.Unturned.Player;
using SDG.Unturned;
using Steamworks;
using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Threading.Tasks;
using UnityEngine;

namespace KRPCarKeys
{
    public class Main : RocketPlugin<Configuration>
    {
        public static Main Instance;
        public static VehicleDatabase Database;
        public static RestoreDatabase RestoreDatabase;

        private Harmony _harmony;

        public static readonly ushort[] KeyIds = { 58124, 58125, 58126, 58127, 58128, 58129, 58130, 58131 };

        protected override void Load()
        {
            Instance = this;
            Database = new VehicleDatabase(Directory);
            RestoreDatabase = new RestoreDatabase(Directory);

            _harmony = new Harmony("com.krp.carkeys");
            _harmony.PatchAll();

            Provider.onServerDisconnected += OnServerDisconnected;
            Provider.onServerConnected += OnPlayerConnected;

            Rocket.Core.Logging.Logger.Log("[KRPCarKeys] Загружен!");
        }

        private void OnPlayerConnected(CSteamID steamID)
        {
            LoadPlayerVehicles(steamID);
        }

        public ulong FindGuidByInstanceID(int instanceID)
        {
            return Database.GetGuidByInstanceID(instanceID);
        }

        private void CloseAllOpenVehicles()
        {
            int closedCount = 0;

            foreach (var vehicle in VehicleManager.vehicles)
            {
                ulong guid = 0;
                if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
                {
                    guid = vehicle.lockedOwner.m_SteamID;
                }
                else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
                {
                    guid = vehicle.lockedGroup.m_SteamID;
                }

                if (guid != 0) continue;

                guid = FindGuidByInstanceID((int)vehicle.instanceID);
                if (guid == 0) continue;

                VehicleManager.ServerSetVehicleLock(vehicle, new CSteamID(guid), new CSteamID(guid), true);
                closedCount++;
            }

            if (closedCount > 0)
            {
                Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Закрыто {closedCount} машин");
            }
        }

        private void UnloadAllVehicles()
        {
            int unloadedCount = 0;
            List<InteractableVehicle> vehiclesToRemove = new List<InteractableVehicle>();

            foreach (var vehicle in VehicleManager.vehicles)
            {
                // 🔥 Проверяем исключения
                if (Configuration.Instance?.VehicleExceptions?.Contains(vehicle.asset.id) == true)
                {
                    continue; // Пропускаем выгрузку
                }

                ulong guid = 0;
                if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
                {
                    guid = vehicle.lockedOwner.m_SteamID;
                }
                else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
                {
                    guid = vehicle.lockedGroup.m_SteamID;
                }

                if (guid == 0)
                {
                    guid = FindGuidByInstanceID((int)vehicle.instanceID);
                    if (guid == 0) continue;
                }

                if (!vehicle.isLocked)
                {
                    VehicleManager.ServerSetVehicleLock(vehicle, new CSteamID(guid), new CSteamID(guid), true);
                }

                if (vehicle.trunkItems != null)
                {
                    while (vehicle.trunkItems.getItemCount() > 0)
                    {
                        vehicle.trunkItems.removeItem(0);
                    }
                }

                vehiclesToRemove.Add(vehicle);
                unloadedCount++;
            }

            foreach (var vehicle in vehiclesToRemove)
            {
                VehicleManager.askVehicleDestroy(vehicle);
            }

            Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Выгружено {unloadedCount} машин из мира");
        }

        private void UnloadVehicle(ulong guid)
        {
            try
            {
                InteractableVehicle targetVehicle = null;

                foreach (var vehicle in VehicleManager.vehicles)
                {
                    ulong vehicleGuid = 0;
                    if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
                    {
                        vehicleGuid = vehicle.lockedOwner.m_SteamID;
                    }
                    else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
                    {
                        vehicleGuid = vehicle.lockedGroup.m_SteamID;
                    }

                    if (vehicleGuid == guid)
                    {
                        targetVehicle = vehicle;
                        break;
                    }
                }

                if (targetVehicle == null)
                {
                    VehicleData data = Database.LoadVehicle(guid);
                    if (data != null)
                    {
                        foreach (var vehicle in VehicleManager.vehicles)
                        {
                            if (data.instanceID == (int)vehicle.instanceID)
                            {
                                targetVehicle = vehicle;
                                break;
                            }
                        }
                    }
                }

                if (targetVehicle == null)
                {
                    Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Машина (GUID: {guid}) не найдена в мире для выгрузки");
                    return;
                }

                // 🔥 Проверяем исключения
                if (Configuration.Instance?.VehicleExceptions?.Contains(targetVehicle.asset.id) == true)
                {
                    Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Машина '{targetVehicle.asset.FriendlyName}' (ID: {targetVehicle.asset.id}) в исключениях — выгрузка пропущена");
                    return;
                }

                if (targetVehicle.passengers != null)
                {
                    foreach (var passenger in targetVehicle.passengers)
                    {
                        if (passenger != null && passenger.player != null)
                        {
                            Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Машина (GUID: {guid}) не может быть выгружена — внутри есть игрок");
                            Task.Delay(60000).ContinueWith(_ =>
                            {
                                Rocket.Core.Utils.TaskDispatcher.QueueOnMainThread(() =>
                                {
                                    UnloadVehicle(guid);
                                });
                            });
                            return;
                        }
                    }
                }

                if (!targetVehicle.isLocked)
                {
                    VehicleManager.ServerSetVehicleLock(targetVehicle, new CSteamID(guid), new CSteamID(guid), true);
                    Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Машина (GUID: {guid}) закрыта перед выгрузкой");
                }

                VehicleData saveData = Database.LoadVehicle(guid);
                if (saveData == null)
                {
                    saveData = new VehicleData
                    {
                        GUID = guid,
                        vehicleID = targetVehicle.asset?.id ?? 0,
                        vehicleName = targetVehicle.asset?.FriendlyName ?? "Unknown"
                    };
                }

                // Сохраняем состояние
                saveData.health = targetVehicle.health;
                saveData.fuel = targetVehicle.fuel;
                saveData.battery = targetVehicle.batteryCharge;
                saveData.lastPosition = new Vector3Data
                {
                    x = targetVehicle.transform.position.x,
                    y = targetVehicle.transform.position.y,
                    z = targetVehicle.transform.position.z
                };
                saveData.rotationY = targetVehicle.transform.eulerAngles.y;

                // Сохраняем колёса (битовая маска)
                saveData.wheels = new byte[] { targetVehicle.tireAliveMask };

                // Сохраняем багаж
                saveData.baggage.Clear();
                if (targetVehicle.trunkItems != null)
                {
                    for (byte i = 0; i < targetVehicle.trunkItems.getItemCount(); i++)
                    {
                        ItemJar jar = targetVehicle.trunkItems.getItem(i);
                        if (jar != null && jar.item != null)
                        {
                            KRPCarKeys.Database.ItemData itemData = new KRPCarKeys.Database.ItemData
                            {
                                itemID = jar.item.id,
                                amount = jar.item.amount,
                                quality = jar.item.quality,
                                state = jar.item.state,
                                x = jar.x,
                                y = jar.y,
                                rot = jar.rot
                            };
                            saveData.baggage.Add(itemData);
                        }
                    }
                }

                saveData.instanceID = (int)targetVehicle.instanceID;
                Database.SaveVehicle(saveData);

                if (targetVehicle.trunkItems != null)
                {
                    while (targetVehicle.trunkItems.getItemCount() > 0)
                    {
                        targetVehicle.trunkItems.removeItem(0);
                    }
                }

                VehicleManager.askVehicleDestroy(targetVehicle);
                saveData.instanceID = 0;
                Database.SaveVehicle(saveData);

                Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Машина '{saveData.vehicleName}' (GUID: {guid}) выгружена из мира и сохранена в БД");
            }
            catch (Exception ex)
            {
                Rocket.Core.Logging.Logger.Log($"[ERROR] UnloadVehicle: {ex.Message}");
            }
        }

        private void LoadPlayerVehicles(CSteamID steamID)
        {
            string steamId = steamID.ToString();

            var allData = Database.GetAll();
            int loadedCount = 0;

            foreach (var kvp in allData)
            {
                VehicleData data = kvp.Value;

                bool hasKey = data.keys.Any(k => k.Owner == steamId);
                if (!hasKey) continue;

                bool hasKeyInInventory = CheckKeyInInventory(steamID, data.GUID);

                if (!hasKeyInInventory)
                {
                    var keyToRemove = data.keys.FirstOrDefault(k => k.Owner == steamId);
                    if (keyToRemove != null)
                    {
                        data.keys.Remove(keyToRemove);
                        Database.SaveVehicle(data);
                        Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Удалён ключ для машины {data.GUID} у игрока {steamId} (ключа нет в инвентаре)");
                    }
                    continue;
                }

                bool alreadySpawned = false;
                foreach (var vehicle in VehicleManager.vehicles)
                {
                    ulong vehicleGuid = 0;
                    if (IsOurGUID(vehicle.lockedOwner.m_SteamID))
                        vehicleGuid = vehicle.lockedOwner.m_SteamID;
                    else if (IsOurGUID(vehicle.lockedGroup.m_SteamID))
                        vehicleGuid = vehicle.lockedGroup.m_SteamID;

                    if (vehicleGuid == data.GUID)
                    {
                        alreadySpawned = true;
                        break;
                    }
                }

                if (alreadySpawned)
                {
                    Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Машина {data.GUID} уже есть в мире");
                    continue;
                }

                LoadVehicleFromData(data);
                loadedCount++;
            }

            if (loadedCount > 0)
            {
                Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Загружено {loadedCount} машин для игрока {steamId}");
            }
        }

        private bool CheckKeyInInventory(CSteamID steamID, ulong guid)
        {
            SteamPlayer steamPlayer = Provider.clients.FirstOrDefault(c => c.playerID.steamID == steamID);
            if (steamPlayer == null) return false;

            UnturnedPlayer player = UnturnedPlayer.FromSteamPlayer(steamPlayer);
            if (player == null) return false;

            for (byte page = 0; page < player.Player.inventory.items.Length; page++)
            {
                var items = player.Player.inventory.items[page];
                if (items == null) continue;

                var itemList = items.items;
                if (itemList == null) continue;

                for (int i = 0; i < itemList.Count; i++)
                {
                    ItemJar jar = itemList[i];
                    if (jar == null || jar.item == null) continue;
                    if (!Main.KeyIds.Contains(jar.item.id)) continue;
                    if (jar.item.state == null || jar.item.state.Length < 8) continue;

                    ulong keyGuid = BitConverter.ToUInt64(jar.item.state, 0);
                    if (keyGuid == guid)
                    {
                        return true;
                    }
                }
            }

            return false;
        }

        private void LoadVehicleFromData(VehicleData data)
        {
            try
            {
                if (data.lastPosition == null)
                {
                    Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Нет позиции для машины {data.GUID}");
                    return;
                }

                Vector3 pos = new Vector3(data.lastPosition.x, data.lastPosition.y, data.lastPosition.z);
                Quaternion rot = Quaternion.Euler(0f, data.rotationY, 0f);

                InteractableVehicle vehicle = VehicleManager.spawnVehicleV2(data.vehicleID, pos, rot);

                if (vehicle == null)
                {
                    Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Ошибка при спавне машины {data.GUID}");
                    return;
                }

                VehicleManager.ServerSetVehicleLock(vehicle, new CSteamID(data.GUID), new CSteamID(data.GUID), true);

                vehicle.health = data.health;
                vehicle.fuel = data.fuel;
                vehicle.batteryCharge = data.battery;
                VehicleManager.sendVehicleHealth(vehicle, data.health);
                VehicleManager.sendVehicleFuel(vehicle, data.fuel);
                VehicleManager.sendVehicleBatteryCharge(vehicle, data.battery);

                if (data.wheels != null && data.wheels.Length > 0)
                {
                    vehicle.tireAliveMask = data.wheels[0];
                    VehicleManager.sendVehicleTireAliveMask(vehicle, data.wheels[0]);
                }

                if (data.baggage != null && data.baggage.Count > 0)
                {
                    if (vehicle.trunkItems == null)
                    {
                        vehicle.trunkItems = new Items(7);
                    }

                    foreach (var itemData in data.baggage)
                    {
                        if (itemData == null) continue;
                        Item item = new Item(itemData.itemID, itemData.amount, itemData.quality, itemData.state);
                        vehicle.trunkItems.addItem(itemData.x, itemData.y, itemData.rot, item);
                    }
                }

                data.instanceID = (int)vehicle.instanceID;
                Database.SaveVehicle(data);

                vehicle.MarkForReplicationUpdate();
                VehicleManager.ServerSetVehicleLock(vehicle, vehicle.lockedOwner, vehicle.lockedGroup, vehicle.isLocked);

                Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Машина '{data.vehicleName}' (GUID: {data.GUID}) загружена");
            }
            catch (Exception ex)
            {
                Rocket.Core.Logging.Logger.Log($"[ERROR] LoadVehicleFromData: {ex.Message}");
            }
        }

        private void OnServerDisconnected(CSteamID steamID)
        {
            if (steamID == CSteamID.Nil) return;

            string steamId = steamID.ToString();

            List<ulong> inventoryGuids = new List<ulong>();

            SteamPlayer steamPlayer = Provider.clients.FirstOrDefault(c => c.playerID.steamID == steamID);
            if (steamPlayer != null)
            {
                UnturnedPlayer player = UnturnedPlayer.FromSteamPlayer(steamPlayer);
                if (player != null)
                {
                    for (byte page = 0; page < player.Player.inventory.items.Length; page++)
                    {
                        var items = player.Player.inventory.items[page];
                        if (items == null) continue;

                        var itemList = items.items;
                        if (itemList == null) continue;

                        for (int i = 0; i < itemList.Count; i++)
                        {
                            ItemJar jar = itemList[i];
                            if (jar == null || jar.item == null) continue;
                            if (!Main.KeyIds.Contains(jar.item.id)) continue;
                            if (jar.item.state == null || jar.item.state.Length < 8) continue;

                            ulong keyGuid = BitConverter.ToUInt64(jar.item.state, 0);
                            if (Main.IsOurGUID(keyGuid))
                            {
                                inventoryGuids.Add(keyGuid);
                            }
                        }
                    }
                }
            }

            var allData = Database.GetAll();
            bool hasChanges = false;

            foreach (var kvp in allData)
            {
                VehicleData data = kvp.Value;
                bool needToRemove = false;

                foreach (var keyData in data.keys)
                {
                    if (keyData.Owner == steamId)
                    {
                        needToRemove = true;
                        break;
                    }
                }

                if (!needToRemove) continue;

                List<KeyData> keysToRemove = new List<KeyData>();
                foreach (var keyData in data.keys)
                {
                    if (keyData.Owner != steamId) continue;

                    if (!inventoryGuids.Contains(keyData.state))
                    {
                        keysToRemove.Add(keyData);
                        hasChanges = true;
                    }
                }

                foreach (var keyToRemove in keysToRemove)
                {
                    data.keys.Remove(keyToRemove);
                }

                if (data.keys.Count > 0)
                {
                    bool anyOwnerOnline = false;
                    foreach (var keyData in data.keys)
                    {
                        if (keyData.Owner == steamId) continue;

                        if (Provider.clients.Any(c => c.playerID.steamID.ToString() == keyData.Owner))
                        {
                            anyOwnerOnline = true;
                            break;
                        }
                    }

                    if (!anyOwnerOnline)
                    {
                        // 🔥 Проверяем исключения перед запуском таймера
                        if (Configuration.Instance?.VehicleExceptions?.Contains(data.vehicleID) == true)
                        {
                            continue; // Не запускаем таймер
                        }

                        ulong guid = data.GUID;

                        Task.Delay(60000).ContinueWith(_ =>
                        {
                            Rocket.Core.Utils.TaskDispatcher.QueueOnMainThread(() =>
                            {
                                UnloadVehicle(guid);
                            });
                        });
                    }
                }
            }

            if (hasChanges)
            {
                Database.ForceSaveAll();
            }
        }

        private void SaveAllVehicles()
        {
            int savedCount = 0;

            foreach (var vehicle in VehicleManager.vehicles)
            {
                ulong guid = 0;
                if (Main.IsOurGUID(vehicle.lockedOwner.m_SteamID))
                {
                    guid = vehicle.lockedOwner.m_SteamID;
                }
                else if (Main.IsOurGUID(vehicle.lockedGroup.m_SteamID))
                {
                    guid = vehicle.lockedGroup.m_SteamID;
                }

                if (guid == 0) continue;

                VehicleData data = Main.Database.LoadVehicle(guid);
                if (data == null)
                {
                    data = new VehicleData
                    {
                        GUID = guid,
                        vehicleID = vehicle.asset?.id ?? 0,
                        vehicleName = vehicle.asset?.FriendlyName ?? "Unknown"
                    };
                }

                data.health = vehicle.health;
                data.fuel = vehicle.fuel;
                data.battery = vehicle.batteryCharge;
                data.lastPosition = new Vector3Data
                {
                    x = vehicle.transform.position.x,
                    y = vehicle.transform.position.y,
                    z = vehicle.transform.position.z
                };
                data.rotationY = vehicle.transform.eulerAngles.y;

                // Сохраняем колёса (битовая маска)
                data.wheels = new byte[] { vehicle.tireAliveMask };

                // Сохраняем багаж
                data.baggage.Clear();
                if (vehicle.trunkItems != null)
                {
                    for (byte i = 0; i < vehicle.trunkItems.getItemCount(); i++)
                    {
                        ItemJar jar = vehicle.trunkItems.getItem(i);
                        if (jar != null && jar.item != null)
                        {
                            KRPCarKeys.Database.ItemData itemData = new KRPCarKeys.Database.ItemData
                            {
                                itemID = jar.item.id,
                                amount = jar.item.amount,
                                quality = jar.item.quality,
                                state = jar.item.state,
                                x = jar.x,
                                y = jar.y,
                                rot = jar.rot
                            };
                            data.baggage.Add(itemData);
                        }
                    }
                }

                Main.Database.SaveVehicle(data);
                savedCount++;
            }

            Rocket.Core.Logging.Logger.Log($"[KRPCarKeys] Сохранено {savedCount} машин");
        }

        protected override void Unload()
        {
            Provider.onServerDisconnected -= OnServerDisconnected;
            Provider.onServerConnected -= OnPlayerConnected;

            SaveAllVehicles();
            UnloadAllVehicles();

            _harmony?.UnpatchAll("com.krp.carkeys");

            Database?.ForceSaveAll();
            RestoreDatabase?.ForceSaveAll();

            Rocket.Core.Logging.Logger.Log("[KRPCarKeys] Выгружен");
        }

        public static ulong GenerateGUID()
        {
            System.Random random = new System.Random();
            return (ulong)random.Next(1000000, 999999999);
        }

        public static bool IsOurGUID(ulong id)
        {
            return id >= 1000000 && id <= 999999999;
        }
    }
}
